+// Camoufox: Chrome's non-standard performance.memory, on the Android device
+// profiles only. As in Chrome, MemoryInfo has no interface object.
+[LegacyNoInterfaceObject, Exposed=Window]
+interface MemoryInfo {
+  readonly attribute unsigned long long jsHeapSizeLimit;
+  readonly attribute unsigned long long totalJSHeapSize;
+  readonly attribute unsigned long long usedJSHeapSize;
+};
+
+[Exposed=Window]
+partial interface Performance {
+  [Func="mozilla::dom::AndroidDevice::Exposed"]
+  readonly attribute MemoryInfo memory;
+};
