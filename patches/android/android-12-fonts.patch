diff --git a/browser/fonts/moz.build b/browser/fonts/moz.build
index 0ebf2de60f..0b18c825c9 100644
--- a/browser/fonts/moz.build
+++ b/browser/fonts/moz.build
@@ -5,3 +5,20 @@
 if CONFIG["MOZ_WIDGET_TOOLKIT"] in ("windows", "gtk"):
     DIST_SUBDIR = ""
     FINAL_TARGET_FILES.fonts += ["TwemojiMozilla.ttf"]
+
+    # Camoufox: Android's system fonts, for the Android device profiles --
+    # Roboto (variable; sans-serif and system-ui), Noto Serif (serif), Droid
+    # Sans Mono (monospace) and Noto Color Emoji, the files Android itself
+    # ships (see android/README). They are activated with Twemoji; the
+    # profile's font allowlist keeps them out of every other fingerprint.
+    # Flat in fonts/, like the packaged font bundles: only fontconfig reads
+    # subfolders.
+    FINAL_TARGET_FILES.fonts += [
+        "android/DroidSansMono.ttf",
+        "android/NotoColorEmoji.ttf",
+        "android/NotoSerif-Bold.ttf",
+        "android/NotoSerif-BoldItalic.ttf",
+        "android/NotoSerif-Italic.ttf",
+        "android/NotoSerif-Regular.ttf",
+        "android/Roboto-Regular.ttf",
+    ]
