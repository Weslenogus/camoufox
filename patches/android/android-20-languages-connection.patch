diff --git a/dom/network/Connection.cpp b/dom/network/Connection.cpp
index 81c9fb17e9..ffb77beb64 100644
--- a/dom/network/Connection.cpp
+++ b/dom/network/Connection.cpp
@@ -9,6 +9,11 @@
 #include "Constants.h"
 #include "mozilla/dom/WorkerPrivate.h"
 
+#include <limits>
+
+#include "MaskConfig.hpp"
+#include "mozilla/dom/BindingUtils.h"
+
 /**
  * We have to use macros here because our leak analysis tool things we are
  * leaking strings when we have |static const nsString|. Sad :(
@@ -81,4 +86,46 @@ already_AddRefed<Connection> Connection::CreateForWorker(
   return ConnectionWorker::Create(aWorkerPrivate, aRv);
 }
 
+// Camoufox: "navigator.connection.*" (the Android device profiles).
+ConnectionType Connection::Type() const {
+  if (mShouldResistFingerprinting) {
+    return ConnectionType::Unknown;
+  }
+  if (auto type = MaskConfig::GetString("navigator.connection.type")) {
+    if (auto value = StringToEnum<ConnectionType>(
+            nsDependentCString(type->c_str()))) {
+      return *value;
+    }
+  }
+  return mType;
+}
+
+EffectiveConnectionType Connection::EffectiveType() const {
+  if (auto type =
+          MaskConfig::GetString("navigator.connection.effectiveType")) {
+    if (auto value = StringToEnum<EffectiveConnectionType>(
+            nsDependentCString(type->c_str()))) {
+      return *value;
+    }
+  }
+  return EffectiveConnectionType::_4g;
+}
+
+double Connection::DownlinkMax() const {
+  return MaskConfig::GetDouble("navigator.connection.downlinkMax")
+      .value_or(std::numeric_limits<double>::infinity());
+}
+
+double Connection::Downlink() const {
+  return MaskConfig::GetDouble("navigator.connection.downlink").value_or(10.0);
+}
+
+uint64_t Connection::Rtt() const {
+  return MaskConfig::GetUint64("navigator.connection.rtt").value_or(50);
+}
+
+bool Connection::SaveData() const {
+  return MaskConfig::GetBool("navigator.connection.saveData").value_or(false);
+}
+
 }  // namespace mozilla::dom::network
