+// https://wicg.github.io/netinfo/#effectiveconnectiontype-enum
+enum EffectiveConnectionType {
+    "2g",
+    "3g",
+    "4g",
+    "slow-2g"
+};
+
 [Pref="dom.netinfo.enabled",
  Exposed=(Window,Worker)]
 interface NetworkInformation : EventTarget {
     readonly    attribute ConnectionType type;
+
+    // Camoufox: Chrome's network-quality members, on the Android device
+    // profiles only (values from "navigator.connection.*").
+    [Func="mozilla::dom::AndroidDevice::Exposed"]
+    readonly    attribute EffectiveConnectionType effectiveType;
+    [Func="mozilla::dom::AndroidDevice::Exposed"]
+    readonly    attribute unrestricted double downlinkMax;
+    [Func="mozilla::dom::AndroidDevice::Exposed"]
+    readonly    attribute double downlink;
+    [Func="mozilla::dom::AndroidDevice::Exposed"]
+    readonly    attribute unsigned long long rtt;
+    [Func="mozilla::dom::AndroidDevice::Exposed"]
+    readonly    attribute boolean saveData;
+    [Func="mozilla::dom::AndroidDevice::Exposed"]
+                attribute EventHandler   onchange;
+
                 attribute EventHandler   ontypechange;
 };
