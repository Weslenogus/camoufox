+/* Camoufox: ARM default-NaN emulation. */
+
+#ifndef js_ArmNaN_h
+#define js_ArmNaN_h
+
+#include "jstypes.h"
+
+namespace JS {
+
+/**
+ * Make NaNs that arithmetic creates -- and NaNs written to typed arrays,
+ * DataViews and the asm.js heap -- carry the bit pattern an ARM CPU produces
+ * (0x7FC00000 / 0x7FF8000000000000), on any host. x86 creates the negative
+ * 0xFFC00000 instead, and the sign bit is readable from a Float32Array.
+ *
+ * Process-wide. The JITs read it when they compile, so it must be set before
+ * any script runs and never changed afterwards.
+ */
+extern JS_PUBLIC_API void SetUseArmDefaultNaN(bool value);
+
+}  // namespace JS
+
+#endif /* js_ArmNaN_h */
