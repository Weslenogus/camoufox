+// Camoufox: ARM default NaN (see js::UseArmDefaultNaN). A NaN operand
+// propagates the same way on x86 and ARM, so only a NaN created from ordered
+// operands is replaced -- with the canonical NaN, which is ARM's default NaN.
+// The operands are tested before the operation because `rsd` is both an
+// operand and the result.
+template <typename Op>
+static void WithArmDefaultNaNF64(MacroAssembler& masm, RegF64 rs, RegF64 rsd,
+                                 Op op) {
+  if (!js::UseArmDefaultNaN()) {
+    op();
+    return;
+  }
+  Label operandIsNaN, done;
+  masm.branchDouble(Assembler::DoubleUnordered, rsd, rs, &operandIsNaN);
+  op();
+  masm.canonicalizeDoubleNaN(rsd);
+  masm.jump(&done);
+  masm.bind(&operandIsNaN);
+  op();
+  masm.bind(&done);
+}
+
+template <typename Op>
+static void WithArmDefaultNaNF32(MacroAssembler& masm, RegF32 rs, RegF32 rsd,
+                                 Op op) {
+  if (!js::UseArmDefaultNaN()) {
+    op();
+    return;
+  }
+  Label operandIsNaN, done;
+  masm.branchFloat(Assembler::DoubleUnordered, rsd, rs, &operandIsNaN);
+  op();
+  masm.canonicalizeFloatNaN(rsd);
+  masm.jump(&done);
+  masm.bind(&operandIsNaN);
+  op();
+  masm.bind(&done);
+}
