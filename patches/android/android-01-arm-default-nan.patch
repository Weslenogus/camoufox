diff --git a/js/src/util/DifferentialTesting.h b/js/src/util/DifferentialTesting.h
index 60ddb1a56b..3ead16b049 100644
--- a/js/src/util/DifferentialTesting.h
+++ b/js/src/util/DifferentialTesting.h
@@ -20,6 +20,32 @@ inline bool SupportDifferentialTesting() {
 #endif
 }
 
+// Camoufox: produce the NaN bit patterns of an ARM CPU on any host.
+//
+// x86 and ARM agree on every non-NaN float result and on how an existing NaN
+// propagates. They disagree only on the NaN an operation *creates* from
+// ordered operands (Infinity - Infinity, 0 * Infinity, 0 / 0, sqrt(-1)): SSE
+// produces the negative "real indefinite" 0xFFC00000, ARM the positive default
+// NaN 0x7FC00000. That one sign bit is readable from a typed array
+// (FingerprintJS's architecture signal) and from wasm's reinterpret ops.
+//
+// Set once per process before any script runs (JS::SetUseArmDefaultNaN). The
+// JITs read it at compile time, so it must not change afterwards.
+inline bool UseArmDefaultNaN() {
+  extern bool gUseArmDefaultNaN;
+  return gUseArmDefaultNaN;
+}
+
+// Whether NaNs written to float storage a script can read back bit-for-bit
+// (typed arrays, DataView, the asm.js heap) are canonicalized first.
+// Differential testing wants that to compare runs across CPUs; ARM emulation
+// wants it because the canonical NaN, 0x7FC00000, is ARM's default NaN. A JS
+// Value can only hold a hardware-generated NaN or the canonical one, so
+// canonicalizing at the store is exactly what an ARM CPU would have written.
+inline bool CanonicalizeStoredNaN() {
+  return SupportDifferentialTesting() || UseArmDefaultNaN();
+}
+
 }  // namespace js
 
 #endif /* util_DifferentialTesting_h */
