diff --git a/dom/canvas/WebGLAstcEmulation.h b/dom/canvas/WebGLAstcEmulation.h
new file mode 100644
index 0000000000..06fb6247a5
--- /dev/null
+++ b/dom/canvas/WebGLAstcEmulation.h
@@ -0,0 +1,49 @@
+/* Camoufox: WEBGL_compressed_texture_astc on a GPU without ASTC.
+ *
+ * Every mobile GPU exposes ASTC and desktop GPUs mostly do not, so a phone
+ * profile has to offer the extension on hardware that cannot decode it. When
+ * "webGl:emulateAstc" is set and the driver lacks KHR_texture_compression_astc
+ * the extension is still offered, its formats pass WebGL's own validation
+ * (block sizes, data sizes, sub-image rules) exactly as on an ASTC GPU, and the
+ * image is allocated uncompressed at the same size underneath. The texels are
+ * not decoded -- the texture samples as transparent black -- but every call a
+ * page can make succeeds or fails the way it would on the phone.
+ *
+ * A GPU with real ASTC support is always used as is. */
+#ifndef mozilla_webgl_WebGLAstcEmulation_h
+#define mozilla_webgl_WebGLAstcEmulation_h
+
+#include "GLConsts.h"
+#include "GLContext.h"
+#include "MaskConfig.hpp"
+
+namespace mozilla::webgl {
+
+inline bool IsAstcEmulationRequested() {
+  static const bool requested = MaskConfig::CheckBool("webGl:emulateAstc");
+  return requested;
+}
+
+inline bool IsAstcEmulated(gl::GLContext* gl) {
+  return IsAstcEmulationRequested() &&
+         !gl->IsExtensionSupported(
+             gl::GLContext::KHR_texture_compression_astc_ldr);
+}
+
+inline bool IsAstcFormat(GLenum format) {
+  return (format >= LOCAL_GL_COMPRESSED_RGBA_ASTC_4x4_KHR &&
+          format <= LOCAL_GL_COMPRESSED_RGBA_ASTC_12x12_KHR) ||
+         (format >= LOCAL_GL_COMPRESSED_SRGB8_ALPHA8_ASTC_4x4_KHR &&
+          format <= LOCAL_GL_COMPRESSED_SRGB8_ALPHA8_ASTC_12x12_KHR);
+}
+
+// The uncompressed format an emulated ASTC image is allocated as.
+inline GLenum AstcStandInFormat(GLenum format) {
+  return format >= LOCAL_GL_COMPRESSED_SRGB8_ALPHA8_ASTC_4x4_KHR
+             ? LOCAL_GL_SRGB8_ALPHA8
+             : LOCAL_GL_RGBA8;
+}
+
+}  // namespace mozilla::webgl
+
+#endif  // mozilla_webgl_WebGLAstcEmulation_h
