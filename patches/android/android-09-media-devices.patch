+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Camoufox: the capture devices of an Android phone, as Chrome on Android
+ * reports them.
+ *
+ * Active on the Android device profiles when "mediaDevices:cameras" is set.
+ * Chrome on Android enumerates the Camera2 devices in descending id order --
+ * "camera2 1, facing front" before "camera2 0, facing back" -- plus one
+ * default microphone and one default speaker, both with the literal deviceId
+ * "default". Every other id is 64 lowercase hex digits.
+ *
+ * Capabilities come in two tiers, as in Chrome: InputDeviceInfo.getCapabilities
+ * reports the capture formats (size, frame rate, facing mode), and a running
+ * track's getCapabilities() adds the Image Capture controls the camera has
+ * (zoom, torch, focus and exposure modes). */
+
+#ifndef DOM_MEDIA_ANDROIDMEDIADEVICES_H_
+#define DOM_MEDIA_ANDROIDMEDIADEVICES_H_
+
+#include "mozilla/Maybe.h"
+#include "mozilla/MediaManager.h"
+#include "nsString.h"
+
+namespace mozilla {
+
+namespace dom {
+struct MediaTrackCapabilities;
+struct MediaTrackSettings;
+}  // namespace dom
+
+class AndroidMediaDevices {
+ public:
+  // Whether the Android device set replaces the host's devices.
+  static bool IsActive();
+
+  // The phone's devices, in Chrome's order: microphone, cameras, speaker.
+  static void Enumerate(MediaEngine* aFakeEngine,
+                        MediaManager::MediaDeviceSetRefCnt& aOut);
+
+  // Capabilities of an input device. aRawName identifies the camera; a
+  // device that is not one of the configured cameras (a real or fake capture
+  // device opened by getUserMedia) is described as the first camera, which
+  // is what Chrome opens when no facingMode is asked for. aTrack adds the
+  // Image Capture capabilities a running track reports.
+  static void GetCapabilities(dom::MediaDeviceKind aKind,
+                              const nsAString& aRawName, bool aTrack,
+                              dom::MediaTrackCapabilities& aOut);
+
+  // The facing mode of the configured camera named aRawName, if it is one.
+  // Safe on any thread.
+  static Maybe<nsString> FacingModeOf(const nsAString& aRawName);
+
+  // Adds the camera's facingMode to a video track's settings.
+  static void AddSettings(const nsAString& aRawName,
+                          dom::MediaTrackSettings& aOut);
+
+  // Rewrites an anonymized (base64) device or group id in Chrome's format:
+  // 64 lowercase hex digits. The raw id "default" stays "default".
+  static void ToChromeId(const nsAString& aRawId, nsAString& aId);
+};
+
+}  // namespace mozilla
+
+#endif  // DOM_MEDIA_ANDROIDMEDIADEVICES_H_
