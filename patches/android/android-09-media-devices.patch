 void MediaDeviceInfo::GetLabel(nsString& retval) { retval = mLabel; }
 
+InputDeviceInfo::InputDeviceInfo(const nsAString& aDeviceId,
+                                 MediaDeviceKind aKind, const nsAString& aLabel,
+                                 const nsAString& aGroupId,
+                                 const nsAString& aRawName,
+                                 bool aExposeCapabilities)
+    : MediaDeviceInfo(aDeviceId, aKind, aLabel, aGroupId),
+      mRawName(aRawName),
+      mExposeCapabilities(aExposeCapabilities) {}
+
+JSObject* InputDeviceInfo::WrapObject(JSContext* aCx,
+                                      JS::Handle<JSObject*> aGivenProto) {
+  return InputDeviceInfo_Binding::Wrap(aCx, this, aGivenProto);
+}
+
+void InputDeviceInfo::GetCapabilities(MediaTrackCapabilities& aRetVal) {
+  // Before the page may see the device, Chrome returns an empty dictionary.
+  if (!mExposeCapabilities) {
+    return;
+  }
+  AndroidMediaDevices::GetCapabilities(Kind(), mRawName, /* aTrack */ false,
+                                       aRetVal);
+  nsString id;
+  GetDeviceId(id);
+  aRetVal.mDeviceId.Construct(id);
+  nsString groupId;
+  GetGroupId(groupId);
+  aRetVal.mGroupId.Construct(groupId);
+}
+
 MediaDeviceKind Kind();
 
 }  // namespace mozilla::dom
