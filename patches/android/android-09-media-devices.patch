diff --git a/dom/media/AndroidMediaDevices.cpp b/dom/media/AndroidMediaDevices.cpp
new file mode 100644
index 0000000000..c79859b8de
--- /dev/null
+++ b/dom/media/AndroidMediaDevices.cpp
@@ -0,0 +1,298 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "AndroidMediaDevices.h"
+
+#include <string>
+#include <vector>
+
+#include "AudioDeviceInfo.h"
+#include "MaskConfig.hpp"
+#include "mozilla/Base64.h"
+#include "mozilla/dom/MediaTrackCapabilitiesBinding.h"
+#include "mozilla/dom/MediaTrackSettingsBinding.h"
+
+namespace mozilla {
+
+using dom::MediaDeviceKind;
+using dom::MediaTrackCapabilities;
+using dom::MediaTrackSettings;
+
+namespace {
+
+// One entry of "mediaDevices:cameras".
+struct Camera {
+  nsString mLabel;
+  nsString mFacingMode;
+  uint32_t mWidth = 1920;
+  uint32_t mHeight = 1080;
+  double mFrameRate = 30;
+  // Image Capture controls; absent when the camera has none.
+  bool mHasZoom = false;
+  double mZoomMin = 1, mZoomMax = 1, mZoomStep = 0.1;
+  bool mTorch = false;
+  std::vector<nsString> mFocusModes;
+  std::vector<nsString> mExposureModes;
+};
+
+// The raw id and group id of the default microphone and speaker. Both are
+// the phone's built-in audio, so they share a group, as in Chrome.
+constexpr auto kDefaultId = u"default"_ns;
+constexpr auto kDefaultLabel = u"Default"_ns;
+constexpr auto kBuiltInAudioGroup = u"android-builtin-audio"_ns;
+
+nsString ToString(const nlohmann::json& aValue) {
+  return aValue.is_string()
+             ? NS_ConvertUTF8toUTF16(aValue.get<std::string>().c_str())
+             : nsString();
+}
+
+double ToDouble(const nlohmann::json& aObject, const char* aKey,
+                double aDefault) {
+  auto it = aObject.find(aKey);
+  return it != aObject.end() && it->is_number() ? it->get<double>() : aDefault;
+}
+
+std::vector<nsString> ToStrings(const nlohmann::json& aObject,
+                                const char* aKey) {
+  std::vector<nsString> out;
+  auto it = aObject.find(aKey);
+  if (it != aObject.end() && it->is_array()) {
+    for (const auto& value : *it) {
+      if (value.is_string()) {
+        out.push_back(ToString(value));
+      }
+    }
+  }
+  return out;
+}
+
+// Parsed once: CAMOU_CONFIG never changes after startup. Malformed entries
+// are skipped rather than trusted.
+const std::vector<Camera>& Cameras() {
+  static const std::vector<Camera> cameras = [] {
+    std::vector<Camera> out;
+    const nlohmann::json& config = MaskConfig::GetJson();
+    if (!config.is_object()) {
+      return out;
+    }
+    auto list = config.find("mediaDevices:cameras");
+    if (list == config.end() || !list->is_array()) {
+      return out;
+    }
+    for (const auto& entry : *list) {
+      if (!entry.is_object()) {
+        continue;
+      }
+      Camera camera;
+      auto label = entry.find("label");
+      if (label == entry.end() || !label->is_string()) {
+        continue;
+      }
+      camera.mLabel = ToString(*label);
+      auto facing = entry.find("facingMode");
+      if (facing != entry.end()) {
+        camera.mFacingMode = ToString(*facing);
+      }
+      camera.mWidth = static_cast<uint32_t>(ToDouble(entry, "width", 1920));
+      camera.mHeight = static_cast<uint32_t>(ToDouble(entry, "height", 1080));
+      camera.mFrameRate = ToDouble(entry, "frameRate", 30);
+      auto zoom = entry.find("zoom");
+      if (zoom != entry.end() && zoom->is_object()) {
+        camera.mHasZoom = true;
+        camera.mZoomMin = ToDouble(*zoom, "min", 1);
+        camera.mZoomMax = ToDouble(*zoom, "max", 1);
+        camera.mZoomStep = ToDouble(*zoom, "step", 0.1);
+      }
+      auto torch = entry.find("torch");
+      camera.mTorch = torch != entry.end() && torch->is_boolean() &&
+                      torch->get<bool>();
+      camera.mFocusModes = ToStrings(entry, "focusMode");
+      camera.mExposureModes = ToStrings(entry, "exposureMode");
+      out.push_back(std::move(camera));
+    }
+    return out;
+  }();
+  return cameras;
+}
+
+// The configured camera with this label, or the first one: a device that is
+// not a configured camera is whatever getUserMedia opened by default, which
+// in Chrome on Android is the first camera enumerated.
+const Camera* FindCamera(const nsAString& aRawName) {
+  const auto& cameras = Cameras();
+  for (const auto& camera : cameras) {
+    if (camera.mLabel.Equals(aRawName)) {
+      return &camera;
+    }
+  }
+  return cameras.empty() ? nullptr : &cameras.front();
+}
+
+void AppendLiterals(dom::Optional<dom::Sequence<nsString>>& aOut,
+                    std::initializer_list<nsLiteralString> aValues) {
+  auto& seq = aOut.Construct();
+  for (const auto& value : aValues) {
+    (void)seq.AppendElement(value, fallible);
+  }
+}
+
+void AppendStrings(dom::Optional<dom::Sequence<nsString>>& aOut,
+                   const std::vector<nsString>& aValues) {
+  auto& seq = aOut.Construct();
+  for (const auto& value : aValues) {
+    (void)seq.AppendElement(value, fallible);
+  }
+}
+
+void AppendBothBooleans(dom::Optional<dom::Sequence<bool>>& aOut) {
+  auto& seq = aOut.Construct();
+  (void)seq.AppendElement(true, fallible);
+  (void)seq.AppendElement(false, fallible);
+}
+
+void SetRange(dom::Optional<dom::ULongRange>& aOut, uint32_t aMin,
+              uint32_t aMax) {
+  auto& range = aOut.Construct();
+  range.mMin.Construct(aMin);
+  range.mMax.Construct(aMax);
+}
+
+void SetRange(dom::Optional<dom::DoubleRange>& aOut, double aMin,
+              double aMax) {
+  auto& range = aOut.Construct();
+  range.mMin.Construct(aMin);
+  range.mMax.Construct(aMax);
+}
+
+}  // namespace
+
+/* static */
+bool AndroidMediaDevices::IsActive() {
+  return MaskConfig::IsAndroidDevice() && !Cameras().empty();
+}
+
+/* static */
+void AndroidMediaDevices::Enumerate(MediaEngine* aFakeEngine,
+                                    MediaManager::MediaDeviceSetRefCnt& aOut) {
+  aOut.AppendElement(new MediaDevice(
+      aFakeEngine, dom::MediaSourceEnum::Microphone, kDefaultLabel, kDefaultId,
+      kBuiltInAudioGroup, MediaDevice::IsScary::No,
+      MediaDevice::OsPromptable::No));
+
+  for (const auto& camera : Cameras()) {
+    // Each camera is its own device group; the label doubles as the raw id,
+    // which is only ever exposed hashed.
+    aOut.AppendElement(new MediaDevice(
+        aFakeEngine, dom::MediaSourceEnum::Camera, camera.mLabel,
+        camera.mLabel, camera.mLabel, MediaDevice::IsScary::No,
+        MediaDevice::OsPromptable::No));
+  }
+
+  RefPtr info = new AudioDeviceInfo(
+      nullptr, kDefaultLabel, kBuiltInAudioGroup, u""_ns,
+      CUBEB_DEVICE_TYPE_OUTPUT, CUBEB_DEVICE_STATE_ENABLED,
+      CUBEB_DEVICE_PREF_ALL, CUBEB_DEVICE_FMT_ALL, CUBEB_DEVICE_FMT_S16NE, 2,
+      48000, 48000, 48000, 256, 256);
+  aOut.AppendElement(new MediaDevice(aFakeEngine, info, kDefaultId));
+}
+
+/* static */
+void AndroidMediaDevices::GetCapabilities(MediaDeviceKind aKind,
+                                          const nsAString& aRawName,
+                                          bool aTrack,
+                                          MediaTrackCapabilities& aOut) {
+  if (aKind == MediaDeviceKind::Audioinput) {
+    AppendBothBooleans(aOut.mAutoGainControl);
+    SetRange(aOut.mChannelCount, 1, 2);
+    AppendBothBooleans(aOut.mEchoCancellation);
+    AppendBothBooleans(aOut.mNoiseSuppression);
+    SetRange(aOut.mSampleRate, 48000, 48000);
+    SetRange(aOut.mSampleSize, 16, 16);
+    return;
+  }
+  if (aKind != MediaDeviceKind::Videoinput) {
+    return;
+  }
+  const Camera* camera = FindCamera(aRawName);
+  if (!camera) {
+    return;
+  }
+
+  SetRange(aOut.mWidth, 1, camera->mWidth);
+  SetRange(aOut.mHeight, 1, camera->mHeight);
+  SetRange(aOut.mAspectRatio, 1.0 / camera->mHeight, camera->mWidth);
+  SetRange(aOut.mFrameRate, 1, camera->mFrameRate);
+  if (!camera->mFacingMode.IsEmpty()) {
+    AppendStrings(aOut.mFacingMode, std::vector<nsString>{camera->mFacingMode});
+  } else {
+    aOut.mFacingMode.Construct();
+  }
+  AppendLiterals(aOut.mResizeMode, {u"none"_ns, u"crop-and-scale"_ns});
+
+  if (!aTrack) {
+    return;
+  }
+  if (!camera->mExposureModes.empty()) {
+    AppendStrings(aOut.mExposureMode, camera->mExposureModes);
+  }
+  if (!camera->mFocusModes.empty()) {
+    AppendStrings(aOut.mFocusMode, camera->mFocusModes);
+  }
+  if (camera->mHasZoom) {
+    auto& zoom = aOut.mZoom.Construct();
+    zoom.mMin.Construct(camera->mZoomMin);
+    zoom.mMax.Construct(camera->mZoomMax);
+    zoom.mStep.Construct(camera->mZoomStep);
+  }
+  if (camera->mTorch) {
+    aOut.mTorch.Construct(true);
+  }
+}
+
+/* static */
+Maybe<nsString> AndroidMediaDevices::FacingModeOf(const nsAString& aRawName) {
+  if (!IsActive()) {
+    return Nothing();
+  }
+  for (const auto& camera : Cameras()) {
+    if (camera.mLabel.Equals(aRawName) && !camera.mFacingMode.IsEmpty()) {
+      return Some(camera.mFacingMode);
+    }
+  }
+  return Nothing();
+}
+
+/* static */
+void AndroidMediaDevices::AddSettings(const nsAString& aRawName,
+                                      MediaTrackSettings& aOut) {
+  const Camera* camera = FindCamera(aRawName);
+  if (camera && !camera->mFacingMode.IsEmpty()) {
+    // The source may already have reported one.
+    aOut.mFacingMode.Reset();
+    aOut.mFacingMode.Construct(camera->mFacingMode);
+  }
+}
+
+/* static */
+void AndroidMediaDevices::ToChromeId(const nsAString& aRawId, nsAString& aId) {
+  if (aRawId.Equals(kDefaultId)) {
+    aId.Assign(kDefaultId);
+    return;
+  }
+  nsAutoCString bytes;
+  if (NS_FAILED(Base64Decode(NS_ConvertUTF16toUTF8(aId), bytes))) {
+    return;
+  }
+  static const char kHex[] = "0123456789abcdef";
+  nsAutoString hex;
+  for (uint32_t i = 0; i < bytes.Length(); ++i) {
+    const auto byte = static_cast<uint8_t>(bytes[i]);
+    hex.Append(char16_t(kHex[byte >> 4]));
+    hex.Append(char16_t(kHex[byte & 0xf]));
+  }
+  aId.Assign(hex);
+}
+
+}  // namespace mozilla
