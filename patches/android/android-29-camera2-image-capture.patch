+// VideoCaptureCamera2's COLOR_TEMPERATURES_MAP keys: the colour temperature
+// of each white balance preset.
+constexpr int32_t kWhiteBalancePresets[] = {2850, 2950, 4250, 4600,
+                                            5000, 6000, 7000};
