+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Camoufox: the Image Capture controls of an Android phone's camera, as
+ * Chrome on Android reports and sets them.
+ *
+ * Chrome exposes a Camera2 device's controls -- white balance, exposure and
+ * focus modes, exposure compensation and time, colour temperature, ISO,
+ * focus distance, zoom and torch -- through a camera track's
+ * getCapabilities(), getSettings() and applyConstraints(), and its photo
+ * settings through ImageCapture. One AndroidCameraControls holds those
+ * controls' current values for one capture device; clones of a track copy
+ * them, as Chrome's track clones copy their ImageCapture state.
+ *
+ * The capabilities are the profile's ("mediaDevices:cameras" in
+ * DeviceProfiles.cpp). The values a control takes once set follow Chrome's
+ * VideoCaptureCamera2: zoom snaps to a whole-pixel crop of the sensor,
+ * exposure compensation to the sensor's step, and so on. Constraints are
+ * checked and applied as Blink's ImageCapture does (image_capture.cc).
+ *
+ * Main thread only. */
+
+#ifndef DOM_MEDIA_ANDROIDCAMERACONTROLS_H_
+#define DOM_MEDIA_ANDROIDCAMERACONTROLS_H_
+
+#include "mozilla/Maybe.h"
+#include "mozilla/gfx/Point.h"
+#include "nsISupportsImpl.h"
+#include "nsString.h"
+
+namespace mozilla {
+
+namespace dom {
+struct MediaTrackCapabilities;
+struct MediaTrackConstraints;
+struct MediaTrackConstraintSet;
+struct MediaTrackSettings;
+struct PhotoCapabilities;
+struct PhotoSettings;
+}  // namespace dom
+
+// One configured camera; defined in AndroidMediaDevices.cpp.
+struct AndroidCamera;
+
+class AndroidCameraControls final {
+ public:
+  NS_INLINE_DECL_REFCOUNTING(AndroidCameraControls)
+
+  // The controls of the camera named aRawName (a configured camera's label;
+  // any other device is the first camera, as in AndroidMediaDevices), or
+  // null when no Android device set is active.
+  static already_AddRefed<AndroidCameraControls> Create(
+      const nsAString& aRawName);
+
+  already_AddRefed<AndroidCameraControls> Clone() const;
+
+  // The Image Capture members of a running track's capabilities and
+  // settings.
+  void AddCapabilities(dom::MediaTrackCapabilities& aOut) const;
+  void AddSettings(dom::MediaTrackSettings& aOut) const;
+
+  // An applyConstraints() rejection: an OverconstrainedError naming
+  // mConstraint, or, with mSecurity, a SecurityError.
+  struct Rejection {
+    nsCString mConstraint;
+    nsCString mMessage;
+    bool mSecurity = false;
+  };
+
+  // Applies the Image Capture members of aConstraints, as Blink's
+  // ImageCapture::SetMediaTrackConstraints. aPageVisible: whether the
+  // document is visible (pan, tilt and zoom need it).
+  Maybe<Rejection> ApplyConstraints(
+      const dom::MediaTrackConstraints& aConstraints, bool aPageVisible);
+
+  // The Image Capture values getUserMedia() asked for, applied the way
+  // Chrome's ImageCapture applies the track's initial device settings:
+  // values in range are taken, nothing is rejected.
+  void ApplyInitialConstraints(const dom::MediaTrackConstraints& aConstraints);
+
+  // ImageCapture.
+  void GetPhotoCapabilities(dom::PhotoCapabilities& aOut) const;
+  // aTrackSize: the track's current capture size, which Chrome reports until
+  // a photo size has been set.
+  void GetPhotoSettings(const gfx::IntSize& aTrackSize,
+                        dom::PhotoSettings& aOut) const;
+  // takePhoto()'s checks, made against the photo capabilities once a page
+  // has seen them (Blink skips them before). Returns the NotSupportedError
+  // message on failure.
+  Maybe<nsCString> CheckPhotoSettings(const dom::PhotoSettings& aSettings,
+                                      bool aKnowsCapabilities) const;
+  void SetPhotoOptions(const dom::PhotoSettings& aSettings);
+  // The JPEG size takePhoto() produces: the camera's JPEG output size
+  // closest to the photo size set, or its first (largest) one.
+  gfx::IntSize PhotoSize(const gfx::IntSize& aTrackSize) const;
+
+  // Which constrainable properties a constraint set names: Image Capture
+  // ones, and the others (Blink's ConstraintSetHas[Non]ImageCapture).
+  static bool HasImageCapture(const dom::MediaTrackConstraintSet& aSet);
+  static bool HasNonImageCapture(const dom::MediaTrackConstraintSet& aSet);
+  // Whether the basic set or any advanced set satisfies the predicate.
+  static bool AnySet(const dom::MediaTrackConstraints& aConstraints,
+                     bool (*aPredicate)(const dom::MediaTrackConstraintSet&));
+  // Removes the Image Capture members, where no Android device is emulated
+  // and Firefox's getConstraints() never reports them.
+  static void StripImageCapture(dom::MediaTrackConstraints& aConstraints);
+
+ private:
+  explicit AndroidCameraControls(const AndroidCamera& aCamera);
+  ~AndroidCameraControls() = default;
+
+  // Chrome's reading of a value it was given, as the camera reports it back.
+  double ReportedZoom(double aZoom) const;
+  double ReportedExposureCompensation(double aValue) const;
+  double ReportedColorTemperature() const;
+  double ReportedFocusDistance() const;
+
+  const AndroidCamera& mCamera;
+
+  // Current settings, as the web sees them.
+  nsString mWhiteBalanceMode;
+  nsString mExposureMode;
+  nsString mFocusMode;
+  double mExposureCompensation = 0;
+  double mExposureTime = 0;
+  double mColorTemperature = 0;  // As set; reported via the AWB presets.
+  double mIso = 0;
+  double mFocusDistance = 0;  // As set, in meters; 0 when never set.
+  double mZoom = 1;
+  bool mTorch = false;
+
+  // Photo settings.
+  int32_t mPhotoWidth = 0;
+  int32_t mPhotoHeight = 0;
+  nsString mFillLightMode;
+  bool mRedEyeReduction = false;
+};
+
+}  // namespace mozilla
+
+#endif  // DOM_MEDIA_ANDROIDCAMERACONTROLS_H_
