+void AndroidCameraControls::AddSettings(MediaTrackSettings& aOut) const {
+  if (!mCamera.mWhiteBalanceModes.empty()) {
+    aOut.mWhiteBalanceMode.Construct(mWhiteBalanceMode);
+  }
+  if (!mCamera.mExposureModes.empty()) {
+    aOut.mExposureMode.Construct(mExposureMode);
+  }
+  if (!mCamera.mFocusModes.empty()) {
+    aOut.mFocusMode.Construct(mFocusMode);
+  }
+  if (Reported(mCamera.mExposureCompensation)) {
+    aOut.mExposureCompensation.Construct(
+        ReportedExposureCompensation(mExposureCompensation));
+  }
+  if (Reported(mCamera.mExposureTime)) {
+    aOut.mExposureTime.Construct(mExposureTime);
+  }
+  if (Reported(mCamera.mColorTemperature)) {
+    aOut.mColorTemperature.Construct(ReportedColorTemperature());
+  }
+  if (Reported(mCamera.mIso)) {
+    aOut.mIso.Construct(mIso);
+  }
+  if (Reported(mCamera.mFocusDistance)) {
+    aOut.mFocusDistance.Construct(ReportedFocusDistance());
+  }
+  if (Reported(mCamera.mZoom)) {
+    aOut.mZoom.Construct(mZoom);
+  }
+  if (mCamera.mTorch) {
+    aOut.mTorch.Construct(mTorch);
+  }
+}
+
+double AndroidCameraControls::ReportedZoom(double aZoom) const {
+  // VideoCaptureCamera2 crops the active array to whole pixels and reports
+  // the ratio back, in float.
+  const float maxZoom = static_cast<float>(mCamera.mZoom->mMax);
+  const float zoom = std::max(1.0f, std::min(float(aZoom), maxZoom));
+  const float cropFactor = (zoom - 1) / (2 * zoom);
+  const int32_t width = mCamera.mActiveArray.width;
+  const int32_t left = JavaRound(float(width) * cropFactor);
+  const int32_t right = JavaRound(float(width) * (1 - cropFactor));
+  if (right <= left) {
+    return 1;
+  }
+  return static_cast<double>(float(width) / float(right - left));
+}
+
+double AndroidCameraControls::ReportedExposureCompensation(
+    double aValue) const {
+  // A whole number of compensation steps, scaled back in float.
+  const float step = static_cast<float>(mCamera.mExposureCompensation->mStep);
+  if (step <= 0) {
+    return aValue;
+  }
+  const int32_t steps = static_cast<int32_t>(std::llround(aValue / step));
+  return static_cast<double>(float(steps) * step);
+}
+
+double AndroidCameraControls::ReportedColorTemperature() const {
+  // Only a locked white balance takes a preset, the one closest to the
+  // temperature asked for; under auto white balance none is reported.
+  if (!mWhiteBalanceMode.Equals(kManual) || mColorTemperature <= 0) {
+    return 0;
+  }
+  const int32_t asked = static_cast<int32_t>(std::lround(mColorTemperature));
+  int32_t best = kWhiteBalancePresets[0];
+  for (int32_t preset : kWhiteBalancePresets) {
+    if (std::abs(asked - preset) < std::abs(asked - best)) {
+      best = preset;
+    }
+  }
+  return best;
+}
+
+double AndroidCameraControls::ReportedFocusDistance() const {
+  // Set in meters, held in diopters as a float, reported in meters.
+  if (!mFocusMode.Equals(kManual) || mFocusDistance <= 0) {
+    return 0;
+  }
+  const float diopters = 1.0f / static_cast<float>(mFocusDistance);
+  return static_cast<double>(1.0f / diopters);
+}
+
+Maybe<AndroidCameraControls::Rejection> AndroidCameraControls::ApplyConstraints(
+    const MediaTrackConstraints& aConstraints, bool aPageVisible) {
+  nsTArray<const MediaTrackConstraintSet*> sets;
+  sets.AppendElement(&aConstraints);
+  if (aConstraints.mAdvanced.WasPassed()) {
+    for (const auto& set : aConstraints.mAdvanced.Value()) {
+      sets.AppendElement(&set);
+    }
+  }
+
+  if (!aPageVisible) {
+    for (const auto* set : sets) {
+      for (const auto* member : {&set->mPan, &set->mTilt, &set->mZoom}) {
+        if (member->WasPassed() &&
+            !(member->Value().IsBoolean() && !member->Value().GetAsBoolean())) {
+          return Some(Rejection{""_ns, "the page is not visible"_ns, true});
+        }
+      }
+    }
+  }
+
+  Effective caps = EffectiveOf(mCamera);
+  Selected selected;
+  const double current[6] = {
+      ReportedExposureCompensation(mExposureCompensation),
+      mExposureTime,
+      ReportedColorTemperature(),
+      mIso,
+      ReportedFocusDistance(),
+      mZoom};
+  for (size_t i = 0; i < sets.Length(); ++i) {
+    const SetType type = i == 0   ? SetType::Basic
+                         : i == 1 ? SetType::FirstAdvanced
+                                  : SetType::Advanced;
+    const bool mayReject = type != SetType::Advanced;
+    if (auto rejection = CheckSet(*sets[i], caps, type)) {
+      if (mayReject) {
+        return rejection;
+      }
+      continue;
+    }
+    ApplySet(*sets[i], caps, type, selected, mWhiteBalanceMode,
+             mExposureMode, mFocusMode, current);
+  }
+
+  // VideoCaptureCamera2's SetPhotoOptionsTask.
+  if (selected.mWhiteBalanceMode) {
+    mWhiteBalanceMode = *selected.mWhiteBalanceMode;
+  }
+  if (selected.mExposureMode) {
+    mExposureMode = *selected.mExposureMode;
+  }
+  if (selected.mFocusMode) {
+    mFocusMode = *selected.mFocusMode;
+  }
+  if (selected.mExposureCompensation) {
+    mExposureCompensation = *selected.mExposureCompensation;
+  }
+  if (selected.mExposureTime && *selected.mExposureTime != 0) {
+    // Held as whole nanoseconds.
+    mExposureTime =
+        std::trunc(*selected.mExposureTime * 100000.0) / 100000.0;
+  }
+  if (selected.mColorTemperature && *selected.mColorTemperature > 0) {
+    mColorTemperature = std::round(*selected.mColorTemperature);
+  }
+  if (selected.mIso && *selected.mIso > 0) {
+    mIso = std::round(*selected.mIso);
+  }
+  if (selected.mFocusDistance && *selected.mFocusDistance != 0) {
+    mFocusDistance = *selected.mFocusDistance;
+  }
+  if (selected.mZoom && *selected.mZoom > 0) {
+    mZoom = ReportedZoom(*selected.mZoom);
+  }
+  if (selected.mTorch) {
+    mTorch = *selected.mTorch;
+  }
+  return Nothing();
+}
+
+void AndroidCameraControls::ApplyInitialConstraints(
+    const MediaTrackConstraints& aConstraints) {
+  // The basic set's numeric values, where they fall in the camera's range.
+  auto value = [](const auto& aMember) -> Maybe<double> {
+    if (!aMember.WasPassed()) {
+      return Nothing();
+    }
+    const auto& v = aMember.Value();
+    if (v.IsDouble()) {
+      return Some(v.GetAsDouble());
+    }
+    if (v.IsConstrainDoubleRange()) {
+      const auto& range = v.GetAsConstrainDoubleRange();
+      if (range.mExact.WasPassed()) {
+        return Some(range.mExact.Value());
+      }
+      if (range.mIdeal.WasPassed()) {
+        return Some(range.mIdeal.Value());
+      }
+    }
+    return Nothing();
+  };
+  auto inRange = [](const Maybe<double>& aValue,
+                    const Maybe<AndroidCamera::Range>& aRange) {
+    return aValue && Reported(aRange) && InRange(*aRange, *aValue);
+  };
+  if (auto v = value(aConstraints.mExposureCompensation);
+      inRange(v, mCamera.mExposureCompensation)) {
+    mExposureCompensation = *v;
+  }
+  if (auto v = value(aConstraints.mExposureTime);
+      inRange(v, mCamera.mExposureTime) && *v != 0) {
+    mExposureTime = std::trunc(*v * 100000.0) / 100000.0;
+  }
+  if (auto v = value(aConstraints.mColorTemperature);
+      inRange(v, mCamera.mColorTemperature)) {
+    mColorTemperature = std::round(*v);
+  }
+  if (auto v = value(aConstraints.mIso); inRange(v, mCamera.mIso)) {
+    mIso = std::round(*v);
+  }
+  if (auto v = value(aConstraints.mFocusDistance);
+      inRange(v, mCamera.mFocusDistance)) {
+    mFocusDistance = *v;
+  }
+  if (auto v = value(aConstraints.mZoom); inRange(v, mCamera.mZoom)) {
+    mZoom = ReportedZoom(*v);
+  }
+  if (mCamera.mTorch && aConstraints.mTorch.WasPassed()) {
+    const auto& torch = aConstraints.mTorch.Value();
+    if (torch.IsBoolean()) {
+      mTorch = torch.GetAsBoolean();
+    } else {
+      const auto& params = torch.GetAsConstrainBooleanParameters();
+      if (params.mExact.WasPassed()) {
+        mTorch = params.mExact.Value();
+      } else if (params.mIdeal.WasPassed()) {
+        mTorch = params.mIdeal.Value();
+      }
+    }
+  }
+}
+
+void AndroidCameraControls::GetPhotoCapabilities(
+    dom::PhotoCapabilities& aOut) const {
+  aOut.mRedEyeReduction.Construct(mCamera.mTorch
+                                      ? dom::RedEyeReduction::Controllable
+                                      : dom::RedEyeReduction::Never);
+  int32_t minWidth = INT32_MAX, minHeight = INT32_MAX;
+  int32_t maxWidth = 0, maxHeight = 0;
+  for (const auto& size : mCamera.mPhotoSizes) {
+    minWidth = std::min(minWidth, size.width);
+    minHeight = std::min(minHeight, size.height);
+    maxWidth = std::max(maxWidth, size.width);
+    maxHeight = std::max(maxHeight, size.height);
+  }
+  SetRange(aOut.mImageHeight,
+           AndroidCamera::Range{double(minHeight), double(maxHeight), 1});
+  SetRange(aOut.mImageWidth,
+           AndroidCamera::Range{double(minWidth), double(maxWidth), 1});
+  if (mCamera.mTorch && !mCamera.mFillLightModes.empty()) {
+    auto& modes = aOut.mFillLightMode.Construct();
+    for (const auto& mode : mCamera.mFillLightModes) {
+      if (auto value = dom::StringToEnum<dom::FillLightMode>(mode)) {
+        (void)modes.AppendElement(*value, fallible);
+      }
+    }
+  }
+}
+
+void AndroidCameraControls::GetPhotoSettings(const gfx::IntSize& aTrackSize,
+                                             dom::PhotoSettings& aOut) const {
+  aOut.mImageHeight.Construct(mPhotoHeight > 0 ? mPhotoHeight
+                                               : aTrackSize.height);
+  aOut.mImageWidth.Construct(mPhotoWidth > 0 ? mPhotoWidth
+                                             : aTrackSize.width);
+}
+
+Maybe<nsCString> AndroidCameraControls::CheckPhotoSettings(
+    const dom::PhotoSettings& aSettings, bool aKnowsCapabilities) const {
+  if (!aKnowsCapabilities) {
+    return Nothing();
+  }
+  dom::PhotoCapabilities caps;
+  GetPhotoCapabilities(caps);
+  auto outside = [](double aValue, const dom::MediaSettingsRange& aRange) {
+    return aValue < aRange.mMin.Value() || aValue > aRange.mMax.Value();
+  };
+  if (aSettings.mImageHeight.WasPassed() &&
+      outside(aSettings.mImageHeight.Value(), caps.mImageHeight.Value())) {
+    return Some("imageHeight setting out of range"_ns);
+  }
+  if (aSettings.mImageWidth.WasPassed() &&
+      outside(aSettings.mImageWidth.Value(), caps.mImageWidth.Value())) {
+    return Some("imageWidth setting out of range"_ns);
+  }
+  if (aSettings.mRedEyeReduction.WasPassed() &&
+      caps.mRedEyeReduction.Value() != dom::RedEyeReduction::Controllable) {
+    return Some("redEyeReduction is not controllable."_ns);
+  }
+  if (aSettings.mFillLightMode.WasPassed() &&
+      caps.mFillLightMode.WasPassed() &&
+      !caps.mFillLightMode.Value().Contains(aSettings.mFillLightMode.Value())) {
+    return Some("Unsupported fillLightMode"_ns);
+  }
+  return Nothing();
+}
+
+void AndroidCameraControls::SetPhotoOptions(
+    const dom::PhotoSettings& aSettings) {
+  if (aSettings.mImageWidth.WasPassed() && aSettings.mImageWidth.Value() > 0) {
+    mPhotoWidth = static_cast<int32_t>(std::lround(aSettings.mImageWidth.Value()));
+  }
+  if (aSettings.mImageHeight.WasPassed() &&
+      aSettings.mImageHeight.Value() > 0) {
+    mPhotoHeight =
+        static_cast<int32_t>(std::lround(aSettings.mImageHeight.Value()));
+  }
+  if (aSettings.mRedEyeReduction.WasPassed()) {
+    mRedEyeReduction = aSettings.mRedEyeReduction.Value();
+  }
+  if (aSettings.mFillLightMode.WasPassed()) {
+    mFillLightMode = NS_ConvertASCIItoUTF16(
+        dom::GetEnumString(aSettings.mFillLightMode.Value()));
+  }
+}
+
+gfx::IntSize AndroidCameraControls::PhotoSize(
+    const gfx::IntSize& aTrackSize) const {
+  // VideoCaptureCamera2.findClosestSizeInArray.
+  const gfx::IntSize* closest = nullptr;
+  int64_t minDiff = INT64_MAX;
+  for (const auto& size : mCamera.mPhotoSizes) {
+    const int64_t diff =
+        (mPhotoWidth > 0 ? std::abs(size.width - mPhotoWidth) : 0) +
+        (mPhotoHeight > 0 ? std::abs(size.height - mPhotoHeight) : 0);
+    if (diff < minDiff) {
+      minDiff = diff;
+      closest = &size;
+    }
+  }
+  return closest ? *closest : aTrackSize;
+}
+
+/* static */
+bool AndroidCameraControls::HasImageCapture(const MediaTrackConstraintSet& aSet) {
+  return aSet.mWhiteBalanceMode.WasPassed() || aSet.mExposureMode.WasPassed() ||
+         aSet.mFocusMode.WasPassed() || aSet.mPointsOfInterest.WasPassed() ||
+         aSet.mExposureCompensation.WasPassed() ||
+         aSet.mExposureTime.WasPassed() || aSet.mColorTemperature.WasPassed() ||
+         aSet.mIso.WasPassed() || aSet.mBrightness.WasPassed() ||
+         aSet.mContrast.WasPassed() || aSet.mSaturation.WasPassed() ||
+         aSet.mSharpness.WasPassed() || aSet.mFocusDistance.WasPassed() ||
+         aSet.mPan.WasPassed() || aSet.mTilt.WasPassed() ||
+         aSet.mZoom.WasPassed() || aSet.mTorch.WasPassed();
+}
+
+/* static */
+bool AndroidCameraControls::HasNonImageCapture(
+    const MediaTrackConstraintSet& aSet) {
+  return aSet.mChannelCount.WasPassed() || aSet.mDeviceId.WasPassed() ||
+         aSet.mEchoCancellation.WasPassed() ||
+         aSet.mNoiseSuppression.WasPassed() ||
+         aSet.mAutoGainControl.WasPassed() || aSet.mFacingMode.WasPassed() ||
+         aSet.mResizeMode.WasPassed() || aSet.mFrameRate.WasPassed() ||
+         aSet.mGroupId.WasPassed() || aSet.mHeight.WasPassed() ||
+         aSet.mWidth.WasPassed();
+}
+
+/* static */
+bool AndroidCameraControls::AnySet(
+    const MediaTrackConstraints& aConstraints,
+    bool (*aPredicate)(const MediaTrackConstraintSet&)) {
+  if (aPredicate(aConstraints)) {
+    return true;
+  }
+  if (aConstraints.mAdvanced.WasPassed()) {
+    for (const auto& set : aConstraints.mAdvanced.Value()) {
+      if (aPredicate(set)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+/* static */
+void AndroidCameraControls::StripImageCapture(
+    MediaTrackConstraints& aConstraints) {
+  auto strip = [](MediaTrackConstraintSet& aSet) {
+    aSet.mWhiteBalanceMode.Reset();
+    aSet.mExposureMode.Reset();
+    aSet.mFocusMode.Reset();
+    aSet.mPointsOfInterest.Reset();
+    aSet.mExposureCompensation.Reset();
+    aSet.mExposureTime.Reset();
+    aSet.mColorTemperature.Reset();
+    aSet.mIso.Reset();
+    aSet.mBrightness.Reset();
+    aSet.mContrast.Reset();
+    aSet.mSaturation.Reset();
+    aSet.mSharpness.Reset();
+    aSet.mFocusDistance.Reset();
+    aSet.mPan.Reset();
+    aSet.mTilt.Reset();
+    aSet.mZoom.Reset();
+    aSet.mTorch.Reset();
+  };
+  strip(aConstraints);
+  if (aConstraints.mAdvanced.WasPassed()) {
+    for (auto& set : aConstraints.mAdvanced.Value()) {
+      strip(set);
+    }
+  }
+}
+
 }  // namespace mozilla
