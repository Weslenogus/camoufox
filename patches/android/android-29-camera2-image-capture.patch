+void FakeVideoSource::FillCameraLikeFrame() {
+  const int32_t width = mWidth;
+  const int32_t height = mHeight;
+  const int32_t chromaWidth = (width + 1) / 2;
+  const int32_t chromaHeight = (height + 1) / 2;
+
+  if (mSceneY.IsEmpty()) {
+    // A room lit from one side, out of focus: a soft light patch, a
+    // brighter top, the lens's vignetting. Placed anew each capture.
+    const uint64_t seed = RandomUint64().valueOr(0x9e3779b97f4a7c15);
+    mNoiseState = uint32_t(seed) | 1;
+    const double lightX = 0.55 + double((seed >> 32) & 0xff) / 255.0 * 0.3;
+    const double lightY = 0.2 + double((seed >> 40) & 0xff) / 255.0 * 0.2;
+    const double base = 62 + double((seed >> 48) & 0x1f);
+    auto light = [&](double aX, double aY) {
+      const double dx = aX - lightX, dy = aY - lightY;
+      return std::exp(-(dx * dx + dy * dy) / 0.035);
+    };
+    auto vignette = [](double aX, double aY) {
+      const double dx = aX - 0.5, dy = aY - 0.5;
+      return 1.0 - 0.7 * (dx * dx + dy * dy);
+    };
+    if (!mSceneY.SetLength(size_t(width) * height, fallible) ||
+        !mSceneCb.SetLength(size_t(chromaWidth) * chromaHeight, fallible) ||
+        !mSceneCr.SetLength(size_t(chromaWidth) * chromaHeight, fallible)) {
+      mSceneY.Clear();
+      return;
+    }
+    for (int32_t y = 0; y < height; ++y) {
+      const double ny = (y + 0.5) / height;
+      for (int32_t x = 0; x < width; ++x) {
+        const double nx = (x + 0.5) / width;
+        const double luma =
+            (base + 30 * (1 - ny) + 70 * light(nx, ny)) * vignette(nx, ny);
+        mSceneY[size_t(y) * width + x] =
+            uint8_t(std::clamp(luma, 16.0, 235.0));
+      }
+    }
+    for (int32_t y = 0; y < chromaHeight; ++y) {
+      const double ny = (y + 0.5) / chromaHeight;
+      for (int32_t x = 0; x < chromaWidth; ++x) {
+        const double warm = 7 * light((x + 0.5) / chromaWidth, ny);
+        mSceneCb[size_t(y) * chromaWidth + x] = uint8_t(124 - warm);
+        mSceneCr[size_t(y) * chromaWidth + x] = uint8_t(133 + warm);
+      }
+    }
+  }
+
+  uint32_t state = mNoiseState;
+  auto next = [&state] {
+    state ^= state << 13;
+    state ^= state >> 17;
+    state ^= state << 5;
+    return state;
+  };
+  // Auto exposure settles slowly around its target.
+  const int drift =
+      int(std::lround(1.5 * std::sin(double(mFrameCount++) / 45.0)));
+  const int32_t yStride = mFrameData->mYStride;
+  const int32_t cStride = mFrameData->mCbCrStride;
+  for (int32_t y = 0; y < height; ++y) {
+    uint8_t* row = mFrameData->mYChannel + size_t(y) * yStride;
+    const uint8_t* scene = mSceneY.Elements() + size_t(y) * width;
+    for (int32_t x = 0; x < width; x += 2) {
+      const uint32_t r = next();
+      // Two triangular samples of +-4 from one draw.
+      const int n0 = int(r & 0xf) + int((r >> 4) & 0xf) - 15;
+      const int n1 = int((r >> 8) & 0xf) + int((r >> 12) & 0xf) - 15;
+      row[x] = uint8_t(std::clamp(scene[x] + drift + n0 / 2, 0, 255));
+      if (x + 1 < width) {
+        row[x + 1] =
+            uint8_t(std::clamp(scene[x + 1] + drift + n1 / 2, 0, 255));
+      }
+    }
+  }
+  for (int32_t y = 0; y < chromaHeight; ++y) {
+    uint8_t* cb = mFrameData->mCbChannel + size_t(y) * cStride;
+    uint8_t* cr = mFrameData->mCrChannel + size_t(y) * cStride;
+    const size_t offset = size_t(y) * chromaWidth;
+    for (int32_t x = 0; x < chromaWidth; ++x) {
+      const uint32_t r = next();
+      cb[x] = uint8_t(mSceneCb[offset + x] + int(r & 3) - 1);
+      cr[x] = uint8_t(mSceneCr[offset + x] + int((r >> 2) & 3) - 1);
+    }
+  }
+  mNoiseState = state;
+}
