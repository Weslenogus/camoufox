+
+// AndroidCameraControls
+
+namespace {
+
+using dom::ConstrainDoubleRange;
+using dom::OwningBooleanOrConstrainBooleanParameters;
+using dom::OwningBooleanOrDoubleOrConstrainDoubleRange;
+using dom::OwningDoubleOrConstrainDoubleRange;
+using dom::OwningPoint2DSequenceOrConstrainPoint2DParameters;
+using dom::OwningStringOrStringSequence;
+using dom::OwningStringOrStringSequenceOrConstrainDOMStringParameters;
+using Range = AndroidCamera::Range;
+using Strings = std::vector<nsString>;
+
+constexpr auto kContinuous = u"continuous"_ns;
+constexpr auto kManual = u"manual"_ns;
+
+// Blink's ImageCapture: how a constraint set is read, and the kinds of
+// constraint values (image_capture.cc).
+enum class SetType { Basic, FirstAdvanced, Advanced };
+
+enum class ConstraintType {
+  EmptySequence,
+  BooleanFalse,
+  BooleanTrue,
+  BareValue,
+  BareValueStringSequence,
+  EmptyDictionary,
+  EffectivelyEmptyDictionary,
+  IdealDictionary,
+  MandatoryDictionary,
+};
+
+bool IsEmptySequence(const OwningStringOrStringSequence& aValue) {
+  return aValue.IsStringSequence() && aValue.GetAsStringSequence().IsEmpty();
+}
+
+template <typename Params, typename IsEmpty>
+ConstraintType TypeOfParameters(const Params& aParams, IsEmpty aIsEmpty) {
+  if (!aParams.mExact.WasPassed() && !aParams.mIdeal.WasPassed()) {
+    return ConstraintType::EmptyDictionary;
+  }
+  if (aParams.mExact.WasPassed() && !aIsEmpty(aParams.mExact.Value())) {
+    return ConstraintType::MandatoryDictionary;
+  }
+  if (aParams.mIdeal.WasPassed() && !aIsEmpty(aParams.mIdeal.Value())) {
+    return ConstraintType::IdealDictionary;
+  }
+  return ConstraintType::EffectivelyEmptyDictionary;
+}
+
+ConstraintType TypeOf(
+    const OwningStringOrStringSequenceOrConstrainDOMStringParameters& aValue) {
+  if (aValue.IsConstrainDOMStringParameters()) {
+    return TypeOfParameters(
+        aValue.GetAsConstrainDOMStringParameters(),
+        [](const OwningStringOrStringSequence& v) {
+          return IsEmptySequence(v);
+        });
+  }
+  if (aValue.IsStringSequence()) {
+    return aValue.GetAsStringSequence().IsEmpty()
+               ? ConstraintType::EmptySequence
+               : ConstraintType::BareValueStringSequence;
+  }
+  return ConstraintType::BareValue;
+}
+
+ConstraintType TypeOf(const ConstrainDoubleRange& aRange) {
+  if (aRange.mExact.WasPassed() || aRange.mMax.WasPassed() ||
+      aRange.mMin.WasPassed()) {
+    return ConstraintType::MandatoryDictionary;
+  }
+  if (aRange.mIdeal.WasPassed()) {
+    return ConstraintType::IdealDictionary;
+  }
+  return ConstraintType::EmptyDictionary;
+}
+
+ConstraintType TypeOf(const OwningDoubleOrConstrainDoubleRange& aValue) {
+  return aValue.IsConstrainDoubleRange()
+             ? TypeOf(aValue.GetAsConstrainDoubleRange())
+             : ConstraintType::BareValue;
+}
+
+ConstraintType TypeOf(const OwningBooleanOrDoubleOrConstrainDoubleRange& aValue) {
+  if (aValue.IsBoolean()) {
+    return aValue.GetAsBoolean() ? ConstraintType::BooleanTrue
+                                 : ConstraintType::BooleanFalse;
+  }
+  return aValue.IsConstrainDoubleRange()
+             ? TypeOf(aValue.GetAsConstrainDoubleRange())
+             : ConstraintType::BareValue;
+}
+
+ConstraintType TypeOf(const OwningBooleanOrConstrainBooleanParameters& aValue) {
+  if (aValue.IsConstrainBooleanParameters()) {
+    return TypeOfParameters(aValue.GetAsConstrainBooleanParameters(),
+                            [](bool) { return false; });
+  }
+  return ConstraintType::BareValue;
+}
+
+ConstraintType TypeOf(
+    const OwningPoint2DSequenceOrConstrainPoint2DParameters& aValue) {
+  if (aValue.IsConstrainPoint2DParameters()) {
+    return TypeOfParameters(
+        aValue.GetAsConstrainPoint2DParameters(),
+        [](const dom::Sequence<dom::Point2D>& v) { return v.IsEmpty(); });
+  }
+  return aValue.GetAsPoint2DSequence().IsEmpty()
+             ? ConstraintType::EmptySequence
+             : ConstraintType::BareValue;
+}
+
+bool BareIsExact(SetType aSetType) { return aSetType != SetType::Basic; }
+
+bool IsValueConstraintType(ConstraintType aType, SetType aSetType) {
+  if (aSetType == SetType::FirstAdvanced &&
+      aType != ConstraintType::BareValue) {
+    return false;
+  }
+  switch (aType) {
+    case ConstraintType::BareValue:
+    case ConstraintType::BareValueStringSequence:
+    case ConstraintType::MandatoryDictionary:
+      return true;
+    case ConstraintType::IdealDictionary:
+      return aSetType == SetType::Basic;
+    default:
+      return false;
+  }
+}
+
+template <typename T>
+bool IsValueConstraint(const T& aValue, SetType aSetType) {
+  return IsValueConstraintType(TypeOf(aValue), aSetType);
+}
+
+bool CapabilityExistenceSatisfies(ConstraintType aType, bool aExists,
+                                  SetType aSetType) {
+  switch (aType) {
+    case ConstraintType::BooleanFalse:
+      return BareIsExact(aSetType) ? !aExists : true;
+    case ConstraintType::BooleanTrue:
+    case ConstraintType::BareValue:
+    case ConstraintType::BareValueStringSequence:
+      return BareIsExact(aSetType) ? aExists : true;
+    case ConstraintType::MandatoryDictionary:
+      return aExists;
+    default:
+      return true;
+  }
+}
+
+bool Contains(const Strings& aValues, const nsAString& aValue) {
+  return std::find_if(aValues.begin(), aValues.end(), [&](const nsString& v) {
+           return v.Equals(aValue);
+         }) != aValues.end();
+}
+
+template <typename Seq>
+bool ContainsAny(const Strings& aValues, const Seq& aCandidates) {
+  for (const auto& candidate : aCandidates) {
+    if (Contains(aValues, candidate)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool InRange(const Range& aRange, double aValue) {
+  return aValue <= aRange.mMax && aValue >= aRange.mMin;
+}
+
+// CheckValueConstraint, per constraint kind.
+bool CheckValue(
+    const Strings& aCapability,
+    const OwningStringOrStringSequenceOrConstrainDOMStringParameters& aValue,
+    SetType aSetType) {
+  if (!IsValueConstraint(aValue, aSetType)) {
+    return true;
+  }
+  if (aValue.IsString()) {
+    return !BareIsExact(aSetType) || Contains(aCapability, aValue.GetAsString());
+  }
+  if (aValue.IsStringSequence()) {
+    return !BareIsExact(aSetType) ||
+           ContainsAny(aCapability, aValue.GetAsStringSequence());
+  }
+  const auto& params = aValue.GetAsConstrainDOMStringParameters();
+  if (params.mExact.WasPassed()) {
+    const auto& exact = params.mExact.Value();
+    return exact.IsString() ? Contains(aCapability, exact.GetAsString())
+                            : ContainsAny(aCapability,
+                                          exact.GetAsStringSequence());
+  }
+  return true;
+}
+
+// Double constraints, and zoom's (boolean or ConstrainDouble): a boolean is
+// never a value constraint, so both read as ConstrainDouble here.
+template <typename U>
+bool CheckRangeValue(const Range& aCapability, const U& aValue,
+                     SetType aSetType) {
+  if (!IsValueConstraint(aValue, aSetType)) {
+    return true;
+  }
+  if (aValue.IsDouble()) {
+    return !BareIsExact(aSetType) || InRange(aCapability, aValue.GetAsDouble());
+  }
+  const auto& range = aValue.GetAsConstrainDoubleRange();
+  if (range.mExact.WasPassed()) {
+    const double exact = range.mExact.Value();
+    if ((range.mMax.WasPassed() && exact > range.mMax.Value()) ||
+        (range.mMin.WasPassed() && exact < range.mMin.Value()) ||
+        !InRange(aCapability, exact)) {
+      return false;
+    }
+  }
+  if (range.mMax.WasPassed()) {
+    const double max = range.mMax.Value();
+    if ((range.mMin.WasPassed() && max < range.mMin.Value()) ||
+        max < aCapability.mMin) {
+      return false;
+    }
+  }
+  if (range.mMin.WasPassed() && range.mMin.Value() > aCapability.mMax) {
+    return false;
+  }
+  return true;
+}
+
+bool CheckValue(const std::vector<bool>& aCapability,
+                const OwningBooleanOrConstrainBooleanParameters& aValue,
+                SetType aSetType) {
+  if (!IsValueConstraint(aValue, aSetType)) {
+    return true;
+  }
+  auto contains = [&](bool v) {
+    return std::find(aCapability.begin(), aCapability.end(), v) !=
+           aCapability.end();
+  };
+  if (aValue.IsBoolean()) {
+    return !BareIsExact(aSetType) || contains(aValue.GetAsBoolean());
+  }
+  const auto& params = aValue.GetAsConstrainBooleanParameters();
+  return !params.mExact.WasPassed() || contains(params.mExact.Value());
+}
+
+// The settings a constraint set selects (Blink's mojom PhotoSettings).
+struct Selected {
+  Maybe<nsString> mWhiteBalanceMode;
+  Maybe<nsString> mExposureMode;
+  Maybe<nsString> mFocusMode;
+  Maybe<double> mExposureCompensation;
+  Maybe<double> mExposureTime;
+  Maybe<double> mColorTemperature;
+  Maybe<double> mIso;
+  Maybe<double> mFocusDistance;
+  Maybe<double> mZoom;
+  Maybe<bool> mTorch;
+};
+
+// ApplyValueConstraint, per constraint kind: selects a setting and returns
+// the capability left for the following constraint sets.
+Strings ApplyValue(
+    Maybe<nsString>& aSetting, const Strings& aCapability,
+    const OwningStringOrStringSequenceOrConstrainDOMStringParameters& aValue,
+    SetType aSetType, const nsString& aCurrent) {
+  if (!IsValueConstraint(aValue, aSetType)) {
+    return aCapability;
+  }
+  auto exactOne = [&](const nsString& aExact) {
+    aSetting = Some(aExact);
+    return Strings{aExact};
+  };
+  auto exactMany = [&](const dom::Sequence<nsString>& aExacts) {
+    Strings left;
+    for (const auto& exact : aExacts) {
+      if (Contains(aCapability, exact)) {
+        left.push_back(exact);
+      }
+    }
+    if (!aSetting || !Contains(Strings(aExacts.begin(), aExacts.end()),
+                               *aSetting)) {
+      aSetting = Some(left.empty() ? aCurrent : left.front());
+    }
+    return left;
+  };
+  auto idealOne = [&](const nsString& aIdeal) {
+    aSetting = Some(Contains(aCapability, aIdeal) ? aIdeal : aCurrent);
+    return aCapability;
+  };
+  auto idealMany = [&](const dom::Sequence<nsString>& aIdeals) {
+    if (!aSetting ||
+        !Contains(Strings(aIdeals.begin(), aIdeals.end()), *aSetting)) {
+      nsString name = aCurrent;
+      for (const auto& ideal : aIdeals) {
+        if (Contains(aCapability, ideal)) {
+          name = ideal;
+          break;
+        }
+      }
+      aSetting = Some(name);
+    }
+    return aCapability;
+  };
+  if (aValue.IsString()) {
+    return BareIsExact(aSetType) ? exactOne(aValue.GetAsString())
+                                 : idealOne(aValue.GetAsString());
+  }
+  if (aValue.IsStringSequence()) {
+    return BareIsExact(aSetType) ? exactMany(aValue.GetAsStringSequence())
+                                 : idealMany(aValue.GetAsStringSequence());
+  }
+  const auto& params = aValue.GetAsConstrainDOMStringParameters();
+  if (params.mExact.WasPassed()) {
+    const auto& exact = params.mExact.Value();
+    return exact.IsString() ? exactOne(exact.GetAsString())
+                            : exactMany(exact.GetAsStringSequence());
+  }
+  const auto& ideal = params.mIdeal.Value();
+  return ideal.IsString() ? idealOne(ideal.GetAsString())
+                          : idealMany(ideal.GetAsStringSequence());
+}
+
+template <typename U>
+Range ApplyRangeValue(Maybe<double>& aSetting, const Range& aCapability,
+                      const U& aValue, SetType aSetType, double aCurrent) {
+  if (!IsValueConstraint(aValue, aSetType)) {
+    return aCapability;
+  }
+  auto exact = [&](double aExact) {
+    aSetting = Some(aExact);
+    Range left = aCapability;
+    left.mMin = left.mMax = aExact;
+    return left;
+  };
+  auto ideal = [&](const Range& aLeft, Maybe<double> aIdeal) {
+    aSetting = Some(std::clamp(aIdeal.valueOr(aCurrent), aLeft.mMin,
+                               aLeft.mMax));
+    return aLeft;
+  };
+  if (aValue.IsDouble()) {
+    return BareIsExact(aSetType)
+               ? exact(aValue.GetAsDouble())
+               : ideal(aCapability, Some(aValue.GetAsDouble()));
+  }
+  const auto& range = aValue.GetAsConstrainDoubleRange();
+  if (range.mExact.WasPassed()) {
+    return exact(range.mExact.Value());
+  }
+  Range left = aCapability;
+  if (range.mMax.WasPassed()) {
+    left.mMax = std::min(range.mMax.Value(), aCapability.mMax);
+  }
+  if (range.mMin.WasPassed()) {
+    left.mMin = std::max(range.mMin.Value(), aCapability.mMin);
+  }
+  return ideal(left, range.mIdeal.WasPassed() && aSetType == SetType::Basic
+                         ? Some(range.mIdeal.Value())
+                         : Nothing());
+}
+
+std::vector<bool> ApplyValue(
+    Maybe<bool>& aSetting, const std::vector<bool>& aCapability,
+    const OwningBooleanOrConstrainBooleanParameters& aValue,
+    SetType aSetType) {
+  if (!IsValueConstraint(aValue, aSetType)) {
+    return aCapability;
+  }
+  auto exact = [&](bool aExact) {
+    aSetting = Some(aExact);
+    return std::vector<bool>{aExact};
+  };
+  auto ideal = [&](bool aIdeal) {
+    const bool supported = std::find(aCapability.begin(), aCapability.end(),
+                                     aIdeal) != aCapability.end();
+    aSetting = Some(supported ? aIdeal : aCapability.front());
+    return aCapability;
+  };
+  if (aValue.IsBoolean()) {
+    return BareIsExact(aSetType) ? exact(aValue.GetAsBoolean())
+                                 : ideal(aValue.GetAsBoolean());
+  }
+  const auto& params = aValue.GetAsConstrainBooleanParameters();
+  return params.mExact.WasPassed() ? exact(params.mExact.Value())
+                                   : ideal(params.mIdeal.Value());
+}
+
+// The camera's capabilities, as constraint sets narrow them down.
+struct Effective {
+  Strings mWhiteBalanceMode;
+  Strings mExposureMode;
+  Strings mFocusMode;
+  Maybe<Range> mExposureCompensation;
+  Maybe<Range> mExposureTime;
+  Maybe<Range> mColorTemperature;
+  Maybe<Range> mIso;
+  Maybe<Range> mFocusDistance;
+  Maybe<Range> mZoom;
+  bool mTorch = false;
+  // Blink keeps an exact torch constraint's value as an effective setting.
+  Maybe<bool> mTorchSetting;
+
+  std::vector<bool> TorchValues() const {
+    return mTorchSetting ? std::vector<bool>{*mTorchSetting}
+                         : std::vector<bool>{false, true};
+  }
+};
+
+Maybe<Range> ReportedRange(const Maybe<Range>& aRange) {
+  return Reported(aRange) ? aRange : Nothing();
+}
+
+Effective EffectiveOf(const AndroidCamera& aCamera) {
+  Effective out;
+  out.mWhiteBalanceMode = aCamera.mWhiteBalanceModes;
+  out.mExposureMode = aCamera.mExposureModes;
+  out.mFocusMode = aCamera.mFocusModes;
+  out.mExposureCompensation = ReportedRange(aCamera.mExposureCompensation);
+  out.mExposureTime = ReportedRange(aCamera.mExposureTime);
+  out.mColorTemperature = ReportedRange(aCamera.mColorTemperature);
+  out.mIso = ReportedRange(aCamera.mIso);
+  out.mFocusDistance = ReportedRange(aCamera.mFocusDistance);
+  out.mZoom = ReportedRange(aCamera.mZoom);
+  out.mTorch = aCamera.mTorch;
+  return out;
+}
+
+// GetConstraintWithCapabilityExistenceMismatch: the first constraint naming
+// a control the camera lacks, when the set requires it.
+const char* ExistenceMismatch(const MediaTrackConstraintSet& aSet,
+                              const Effective& aCaps, SetType aSetType) {
+  auto check = [&](const auto& aMember, bool aExists) {
+    return !aMember.WasPassed() ||
+           CapabilityExistenceSatisfies(TypeOf(aMember.Value()), aExists,
+                                        aSetType);
+  };
+  if (!check(aSet.mWhiteBalanceMode, !aCaps.mWhiteBalanceMode.empty())) {
+    return "whiteBalanceMode";
+  }
+  if (!check(aSet.mExposureMode, !aCaps.mExposureMode.empty())) {
+    return "exposureMode";
+  }
+  if (!check(aSet.mFocusMode, !aCaps.mFocusMode.empty())) {
+    return "focusMode";
+  }
+  if (!check(aSet.mExposureCompensation,
+             aCaps.mExposureCompensation.isSome())) {
+    return "exposureCompensation";
+  }
+  if (!check(aSet.mExposureTime, aCaps.mExposureTime.isSome())) {
+    return "exposureTime";
+  }
+  if (!check(aSet.mColorTemperature, aCaps.mColorTemperature.isSome())) {
+    return "colorTemperature";
+  }
+  if (!check(aSet.mIso, aCaps.mIso.isSome())) {
+    return "iso";
+  }
+  if (!check(aSet.mBrightness, false)) {
+    return "brightness";
+  }
+  if (!check(aSet.mContrast, false)) {
+    return "contrast";
+  }
+  if (!check(aSet.mSaturation, false)) {
+    return "saturation";
+  }
+  if (!check(aSet.mSharpness, false)) {
+    return "sharpness";
+  }
+  if (!check(aSet.mFocusDistance, aCaps.mFocusDistance.isSome())) {
+    return "focusDistance";
+  }
+  if (!check(aSet.mPan, false)) {
+    return "pan";
+  }
+  if (!check(aSet.mTilt, false)) {
+    return "tilt";
+  }
+  if (!check(aSet.mZoom, aCaps.mZoom.isSome())) {
+    return "zoom";
+  }
+  if (!check(aSet.mTorch, aCaps.mTorch)) {
+    return "torch";
+  }
+  return nullptr;
+}
+
+// CheckMediaTrackConstraintSet. Returns the rejection, if any.
+Maybe<AndroidCameraControls::Rejection> CheckSet(
+    const MediaTrackConstraintSet& aSet, const Effective& aCaps,
+    SetType aSetType) {
+  auto reject = [](const char* aName, const char* aMessage) {
+    return Some(AndroidCameraControls::Rejection{nsCString(aName),
+                                                 nsCString(aMessage)});
+  };
+  if (const char* name = ExistenceMismatch(aSet, aCaps, aSetType)) {
+    return reject(name, "Unsupported constraint");
+  }
+  if (aSet.mWhiteBalanceMode.WasPassed() && !aCaps.mWhiteBalanceMode.empty() &&
+      !CheckValue(aCaps.mWhiteBalanceMode, aSet.mWhiteBalanceMode.Value(),
+                  aSetType)) {
+    return reject("whiteBalanceMode", "Unsupported whiteBalanceMode.");
+  }
+  if (aSet.mExposureMode.WasPassed() && !aCaps.mExposureMode.empty() &&
+      !CheckValue(aCaps.mExposureMode, aSet.mExposureMode.Value(),
+                  aSetType)) {
+    return reject("exposureMode", "Unsupported exposureMode.");
+  }
+  if (aSet.mFocusMode.WasPassed() && !aCaps.mFocusMode.empty() &&
+      !CheckValue(aCaps.mFocusMode, aSet.mFocusMode.Value(), aSetType)) {
+    return reject("focusMode", "Unsupported focusMode.");
+  }
+  auto checkRange = [&](const auto& aMember, const Maybe<Range>& aCap) {
+    return !aMember.WasPassed() || !aCap ||
+           CheckRangeValue(*aCap, aMember.Value(), aSetType);
+  };
+  if (!checkRange(aSet.mExposureCompensation, aCaps.mExposureCompensation)) {
+    return reject("exposureCompensation",
+                  "exposureCompensation setting out of range");
+  }
+  if (!checkRange(aSet.mExposureTime, aCaps.mExposureTime)) {
+    return reject("exposureTime", "exposureTime setting out of range");
+  }
+  if (!checkRange(aSet.mColorTemperature, aCaps.mColorTemperature)) {
+    return reject("colorTemperature", "colorTemperature setting out of range");
+  }
+  if (!checkRange(aSet.mIso, aCaps.mIso)) {
+    return reject("iso", "iso setting out of range");
+  }
+  if (!checkRange(aSet.mFocusDistance, aCaps.mFocusDistance)) {
+    return reject("focusDistance", "focusDistance setting out of range");
+  }
+  if (!checkRange(aSet.mZoom, aCaps.mZoom)) {
+    return reject("zoom", "zoom setting out of range");
+  }
+  if (aSet.mTorch.WasPassed() && aCaps.mTorch &&
+      !CheckValue(aCaps.TorchValues(), aSet.mTorch.Value(), aSetType)) {
+    return reject("torch", "torch not supported");
+  }
+  return Nothing();
+}
+
+// ApplyMediaTrackConstraintSetToSettings.
+void ApplySet(const MediaTrackConstraintSet& aSet, Effective& aCaps,
+              SetType aSetType, Selected& aOut, const nsString& aWhiteBalanceMode,
+              const nsString& aExposureMode, const nsString& aFocusMode,
+              const double (&aCurrent)[6]) {
+  if (aSet.mWhiteBalanceMode.WasPassed() && !aCaps.mWhiteBalanceMode.empty()) {
+    aCaps.mWhiteBalanceMode =
+        ApplyValue(aOut.mWhiteBalanceMode, aCaps.mWhiteBalanceMode,
+                   aSet.mWhiteBalanceMode.Value(), aSetType, aWhiteBalanceMode);
+  }
+  if (aSet.mExposureMode.WasPassed() && !aCaps.mExposureMode.empty()) {
+    aCaps.mExposureMode =
+        ApplyValue(aOut.mExposureMode, aCaps.mExposureMode,
+                   aSet.mExposureMode.Value(), aSetType, aExposureMode);
+  }
+  if (aSet.mFocusMode.WasPassed() && !aCaps.mFocusMode.empty()) {
+    aCaps.mFocusMode = ApplyValue(aOut.mFocusMode, aCaps.mFocusMode,
+                                  aSet.mFocusMode.Value(), aSetType,
+                                  aFocusMode);
+  }
+  auto range = [&](const auto& aMember, Maybe<Range>& aCap,
+                   Maybe<double>& aSetting, double aCurrentValue) {
+    if (aMember.WasPassed() && aCap) {
+      aCap = Some(ApplyRangeValue(aSetting, *aCap, aMember.Value(), aSetType,
+                                  aCurrentValue));
+    }
+  };
+  range(aSet.mExposureCompensation, aCaps.mExposureCompensation,
+        aOut.mExposureCompensation, aCurrent[0]);
+  range(aSet.mExposureTime, aCaps.mExposureTime, aOut.mExposureTime,
+        aCurrent[1]);
+  range(aSet.mColorTemperature, aCaps.mColorTemperature,
+        aOut.mColorTemperature, aCurrent[2]);
+  range(aSet.mIso, aCaps.mIso, aOut.mIso, aCurrent[3]);
+  range(aSet.mFocusDistance, aCaps.mFocusDistance, aOut.mFocusDistance,
+        aCurrent[4]);
+  range(aSet.mZoom, aCaps.mZoom, aOut.mZoom, aCurrent[5]);
+  if (aSet.mTorch.WasPassed() && aCaps.mTorch) {
+    auto left = ApplyValue(aOut.mTorch, aCaps.TorchValues(),
+                           aSet.mTorch.Value(), aSetType);
+    if (left.size() == 1) {
+      aCaps.mTorchSetting = Some(left.front());
+    }
+  }
+}
+
+// Java's Math.round(float).
+int32_t JavaRound(float aValue) {
+  return static_cast<int32_t>(std::floor(aValue + 0.5f));
+}
