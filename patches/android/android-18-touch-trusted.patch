 // is tracked under; touch identifiers are small non-negative integers.
 static constexpr int32_t kEmulatedFingerForMouse = -1;
 
+// Camoufox: the finger of InitPointerEventFromMouse fires touch events too.
+//
+// A finger on a touchscreen fires touchstart / touchmove / touchend as well as
+// pointer events, and pages listen for either. Mouse input that automation
+// synthesizes on an emulated Android device already reaches the page as a
+// finger's pointer events; right after each one, the matching touch event is
+// dispatched -- trusted, like any event the browser itself generates -- to the
+// element the gesture started on, carrying the same contact geometry. Gecko's
+// mouse events (the compatibility mouse events a tap produces) follow as
+// before.
+static StaticRefPtr<nsIContent> sEmulatedTouchTarget;
+static constexpr int32_t kEmulatedTouchIdentifier = 0;
+
+static void DispatchEmulatedTouchForMouse(PresShell* aShell,
+                                          nsIContent* aTarget,
+                                          const WidgetMouseEvent& aMouseEvent,
+                                          EventMessage aPointerMessage) {
+  if (!dom::Touch::EmulatesFingers() ||
+      !aMouseEvent.mFlags.mIsSynthesizedForTests ||
+      aMouseEvent.mInputSource == MouseEvent_Binding::MOZ_SOURCE_TOUCH ||
+      !aShell) {
+    return;
+  }
+  EventMessage touchMessage;
+  switch (aPointerMessage) {
+    case ePointerDown:
+      if (aMouseEvent.mButton != MouseButton::ePrimary) {
+        return;
+      }
+      touchMessage = eTouchStart;
+      break;
+    case ePointerMove:
+      if (!(aMouseEvent.mButtons & MouseButtonsFlag::ePrimaryFlag) ||
+          !sEmulatedTouchTarget) {
+        return;
+      }
+      touchMessage = eTouchMove;
+      break;
+    case ePointerUp:
+      if (aMouseEvent.mButton != MouseButton::ePrimary ||
+          !sEmulatedTouchTarget) {
+        return;
+      }
+      touchMessage = eTouchEnd;
+      break;
+    default:
+      return;
+  }
+
+  if (touchMessage == eTouchStart) {
+    // A touch targets an element, and keeps the element it started on.
+    nsIContent* target = aTarget;
+    while (target && !target->IsElement()) {
+      target = target->GetFlattenedTreeParent();
+    }
+    if (!target) {
+      return;
+    }
+    if (!sEmulatedTouchTarget) {
+      ClearOnShutdown(&sEmulatedTouchTarget);
+    }
+    sEmulatedTouchTarget = target;
+  }
+  nsCOMPtr<nsIContent> target = sEmulatedTouchTarget.get();
+  if (touchMessage == eTouchEnd) {
+    sEmulatedTouchTarget = nullptr;
+  }
+  nsPresContext* presContext = aShell->GetPresContext();
+  if (!presContext || !target->IsInComposedDoc()) {
+    return;
+  }
+
+  // The same finger as the pointer event just dispatched.
+  const dom::Touch::EmulatedFinger finger =
+      dom::Touch::FingerFor(kEmulatedFingerForMouse, false);
+  const float scale = presContext->CSSToDevPixelScale().scale;
+  RefPtr<dom::Touch> touch = new dom::Touch(
+      kEmulatedTouchIdentifier, aMouseEvent.mRefPoint,
+      LayoutDeviceIntPoint(int32_t(std::lround(finger.mRadiusX * scale)),
+                           int32_t(std::lround(finger.mRadiusY * scale))),
+      finger.mRotationAngle, finger.mForce);
+  touch->SetTouchTarget(target);
+  touch->mChanged = true;
+
+  WidgetTouchEvent touchEvent(true, touchMessage, aMouseEvent.mWidget);
+  touchEvent.mModifiers = aMouseEvent.mModifiers;
+  touchEvent.mTimeStamp = aMouseEvent.mTimeStamp;
+  touchEvent.mTouches.AppendElement(touch);
+  nsEventStatus status = nsEventStatus_eIgnore;
+  EventDispatcher::Dispatch(target, presContext, &touchEvent, nullptr,
+                            &status);
+}
