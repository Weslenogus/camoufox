 #include "js/CharacterEncoding.h"
 #include "js/ColumnNumber.h"  // JS::LimitedColumnNumberOneOrigin, JS::TaggedColumnNumberOneOrigin
 #include "js/ErrorReport.h"           // JSErrorBase
@@ -614,9 +615,43 @@ bool SavedFrame::construct(JSContext* cx, unsigned argc, Value* vp) {
   return false;
 }
 
+// Camoufox: see js/AutomationFrames.h.
+static bool gHideAutomationFrames = false;
+
+static bool AtomStartsWith(JSAtom* aAtom, const char* aPrefix) {
+  const size_t length = strlen(aPrefix);
+  if (aAtom->length() < length) {
+    return false;
+  }
+  for (size_t i = 0; i < length; i++) {
+    if (aAtom->latin1OrTwoByteChar(i) != char16_t(aPrefix[i])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Whether |frame| is automation's -- Juggler's page-side scripts or code it
+// evaluated -- and so must be hidden from a caller with |principals|. Trusted
+// (system) callers, and callers that asked for no filtering, see everything.
+static bool IsHiddenAutomationFrame(JSContext* cx, JSPrincipals* principals,
+                                    SavedFrame* frame) {
+  if (!gHideAutomationFrames || !principals ||
+      principals == cx->runtime()->trustedPrincipals()) {
+    return false;
+  }
+  JSAtom* source = frame->getSource();
+  return source && (AtomStartsWith(source, "chrome://juggler/") ||
+                    AtomStartsWith(source, "debugger eval code"));
+}
+
 static bool SavedFrameSubsumedByPrincipals(JSContext* cx,
                                            JSPrincipals* principals,
                                            Handle<SavedFrame*> frame) {
+  if (IsHiddenAutomationFrame(cx, principals, frame)) {
+    return false;
+  }
+
   auto subsumes = cx->runtime()->securityCallbacks->subsumes;
   if (!subsumes) {
     return true;
@@ -696,7 +731,8 @@ JS_PUBLIC_API JSObject* GetFirstSubsumedSavedFrame(
 
   auto matcher = [subsumes](JSContext* cx, JSPrincipals* principals,
                             Handle<SavedFrame*> frame) -> bool {
-    return subsumes(principals, frame->getPrincipals());
+    return !IsHiddenAutomationFrame(cx, principals, frame) &&
+           subsumes(principals, frame->getPrincipals());
   };
 
   bool skippedAsync;
@@ -2143,3 +2179,7 @@ JS_PUBLIC_API bool ConstructSavedFrameStackSlow(
 
 }  // namespace ubi
 }  // namespace JS
+
+JS_PUBLIC_API void JS::SetHideAutomationFrames(bool value) {
+  js::gHideAutomationFrames = value;
+}
