+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Camoufox: keep automation frames out of page-visible stacks. */
+
+#ifndef js_AutomationFrames_h
+#define js_AutomationFrames_h
+
+#include "jstypes.h"
+
+namespace JS {
+
+/**
+ * Hide the frames automation leaves on the stack when it calls into a page --
+ * Juggler's own scripts (chrome://juggler/...) and the code it evaluates
+ * ("debugger eval code") -- from every stack a non-system caller can observe:
+ * Error.prototype.stack, SavedFrame accessors, DOM exception stacks. Juggler
+ * runs its page-side scripts with the page's principal, so ordinary
+ * principal-based frame filtering keeps them visible.
+ *
+ * Process-wide; set once before any script runs.
+ */
+extern JS_PUBLIC_API void SetHideAutomationFrames(bool value);
+
+}  // namespace JS
+
+#endif /* js_AutomationFrames_h */
