@@ -0,0 +1,90 @@
+/* Camoufox: navigator.contacts for an emulated Android device. See
+ * ContactsManager.h. */
+#include "mozilla/dom/ContactsManager.h"
+
+#include "mozilla/dom/BrowsingContext.h"
+#include "mozilla/dom/ContactsManagerBinding.h"
+#include "mozilla/dom/Promise.h"
+#include "mozilla/dom/WindowContext.h"
+#include "nsPIDOMWindow.h"
+
+namespace mozilla::dom {
+
+NS_IMPL_CYCLE_COLLECTION_WRAPPERCACHE(ContactsManager, mGlobal)
+NS_IMPL_CYCLE_COLLECTING_ADDREF(ContactsManager)
+NS_IMPL_CYCLE_COLLECTING_RELEASE(ContactsManager)
+NS_INTERFACE_MAP_BEGIN_CYCLE_COLLECTION(ContactsManager)
+  NS_WRAPPERCACHE_INTERFACE_MAP_ENTRY
+  NS_INTERFACE_MAP_ENTRY(nsISupports)
+NS_INTERFACE_MAP_END
+
+NS_IMPL_CYCLE_COLLECTION_WRAPPERCACHE(ContactAddress, mGlobal)
+NS_IMPL_CYCLE_COLLECTING_ADDREF(ContactAddress)
+NS_IMPL_CYCLE_COLLECTING_RELEASE(ContactAddress)
+NS_INTERFACE_MAP_BEGIN_CYCLE_COLLECTION(ContactAddress)
+  NS_WRAPPERCACHE_INTERFACE_MAP_ENTRY
+  NS_INTERFACE_MAP_ENTRY(nsISupports)
+NS_INTERFACE_MAP_END
+
+JSObject* ContactsManager::WrapObject(JSContext* aCx,
+                                      JS::Handle<JSObject*> aGivenProto) {
+  return ContactsManager_Binding::Wrap(aCx, this, aGivenProto);
+}
+
+JSObject* ContactAddress::WrapObject(JSContext* aCx,
+                                     JS::Handle<JSObject*> aGivenProto) {
+  return ContactAddress_Binding::Wrap(aCx, this, aGivenProto);
+}
+
+already_AddRefed<Promise> ContactsManager::GetProperties(ErrorResult& aRv) {
+  RefPtr<Promise> promise = Promise::Create(mGlobal, aRv);
+  if (aRv.Failed()) {
+    return nullptr;
+  }
+  // Chrome on Android supports every property.
+  nsTArray<ContactProperty> properties = {
+      ContactProperty::Address, ContactProperty::Email, ContactProperty::Icon,
+      ContactProperty::Name, ContactProperty::Tel};
+  promise->MaybeResolve(properties);
+  return promise.forget();
+}
+
+already_AddRefed<Promise> ContactsManager::Select(
+    const Sequence<ContactProperty>& aProperties,
+    const ContactsSelectOptions& aOptions, ErrorResult& aRv) {
+  RefPtr<Promise> promise = Promise::Create(mGlobal, aRv);
+  if (aRv.Failed()) {
+    return nullptr;
+  }
+
+  // Chrome's checks, in Chrome's order (contacts_manager.cc).
+  nsCOMPtr<nsPIDOMWindowInner> window = do_QueryInterface(mGlobal);
+  BrowsingContext* bc = window ? window->GetBrowsingContext() : nullptr;
+  if (!bc || !bc->IsTop()) {
+    promise->MaybeRejectWithInvalidStateError(
+        "The contacts API can only be used in the top frame");
+    return promise.forget();
+  }
+  WindowContext* wc = window->GetWindowContext();
+  if (!wc || !wc->HasValidTransientUserGestureActivation()) {
+    promise->MaybeRejectWithSecurityError(
+        "A user gesture is required to call this method");
+    return promise.forget();
+  }
+  if (aProperties.IsEmpty()) {
+    promise->MaybeRejectWithTypeError("At least one property must be provided");
+    return promise.forget();
+  }
+  if (mPickerInUse) {
+    promise->MaybeRejectWithInvalidStateError(
+        "Contacts Picker is already in use.");
+    return promise.forget();
+  }
+
+  // The picker opened and was dismissed: no contacts.
+  wc->ConsumeTransientUserGestureActivation();
+  promise->MaybeResolve(nsTArray<nsString>());
+  return promise.forget();
+}
+
+}  // namespace mozilla::dom
diff --git a/dom/base/ContactsManager.h b/dom/base/ContactsManager.h
