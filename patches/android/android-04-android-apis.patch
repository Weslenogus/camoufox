new file mode 100644
index 0000000000..4e0dce6fc6
--- /dev/null
+++ b/dom/webidl/ContactsManager.webidl
@@ -0,0 +1,54 @@
+/* -*- Mode: IDL; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/.
+ *
+ * The origin of this IDL file is
+ * https://w3c.github.io/contact-picker/#idl-index
+ *
+ * Camoufox: the Contact Picker exists only in Chrome on Android, so it is
+ * exposed only on an emulated Android device (AndroidDevice::Exposed). There
+ * is no address book behind it: select() behaves as if the user dismissed
+ * the picker.
+ */
+
+enum ContactProperty { "address", "email", "icon", "name", "tel" };
+
+[SecureContext, Exposed=Window, Func="mozilla::dom::AndroidDevice::Exposed"]
+interface ContactAddress {
+  [Default] object toJSON();
+  readonly attribute DOMString city;
+  readonly attribute DOMString country;
+  readonly attribute DOMString dependentLocality;
+  readonly attribute DOMString organization;
+  readonly attribute DOMString phone;
+  readonly attribute DOMString postalCode;
+  readonly attribute DOMString recipient;
+  readonly attribute DOMString region;
+  readonly attribute DOMString sortingCode;
+  [Frozen, Cached, Pure]
+  readonly attribute sequence<DOMString> addressLine;
+};
+
+dictionary ContactInfo {
+  sequence<ContactAddress> address;
+  sequence<DOMString> email;
+  sequence<Blob> icon;
+  sequence<DOMString> name;
+  sequence<DOMString> tel;
+};
+
+dictionary ContactsSelectOptions {
+  boolean multiple = false;
+};
+
+[SecureContext, Exposed=Window, Func="mozilla::dom::AndroidDevice::Exposed"]
+interface ContactsManager {
+  [NewObject]
+  Promise<sequence<ContactProperty>> getProperties();
+  [NewObject]
+  Promise<sequence<ContactInfo>> select(sequence<ContactProperty> properties,
+                                        optional ContactsSelectOptions options = {});
+};
+
+// navigator.contacts is declared in Navigator.webidl.
diff --git a/dom/webidl/NDEFReader.webidl b/dom/webidl/NDEFReader.webidl
new file mode 100644
index 0000000000..72fc5b5900
--- /dev/null
+++ b/dom/webidl/NDEFReader.webidl
@@ -0,0 +1,102 @@
+/* -*- Mode: IDL; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/.
+ *
+ * The origin of this IDL file is
+ * https://w3c.github.io/web-nfc/#idl-index
+ *
+ * Camoufox: Web NFC exists only in Chrome on Android, so it is exposed only on
+ * an emulated Android device (AndroidDevice::Exposed). There is no NFC
+ * hardware behind it: every operation is refused the way Chrome refuses it
+ * when the NFC permission is not granted.
+ */
+
+[SecureContext, Exposed=Window, Func="mozilla::dom::AndroidDevice::Exposed"]
+interface NDEFMessage {
+  [Throws]
+  constructor(NDEFMessageInit messageInit);
+  [Frozen, Cached, Pure]
+  readonly attribute sequence<NDEFRecord> records;
+};
+
+dictionary NDEFMessageInit {
+  required sequence<NDEFRecordInit> records;
+};
+
+typedef (DOMString or BufferSource or NDEFMessageInit) NDEFMessageSource;
+
+[SecureContext, Exposed=Window, Func="mozilla::dom::AndroidDevice::Exposed"]
+interface NDEFRecord {
+  [Throws]
+  constructor(NDEFRecordInit recordInit);
+
+  readonly attribute USVString recordType;
+  readonly attribute USVString? mediaType;
+  readonly attribute USVString? id;
+  // A DataView in the specification; Gecko's WebIDL has no DataView type,
+  // so the binding returns the DataView NDEFRecord::GetData creates.
+  [Throws]
+  readonly attribute object? data;
+
+  readonly attribute USVString? encoding;
+  readonly attribute USVString? lang;
+
+  sequence<NDEFRecord>? toRecords();
+};
+
+dictionary NDEFRecordInit {
+  required USVString recordType;
+  USVString mediaType;
+  USVString id;
+
+  USVString encoding;
+  USVString lang;
+
+  any data;
+};
+
+[SecureContext, Exposed=Window, Func="mozilla::dom::AndroidDevice::Exposed"]
+interface NDEFReader : EventTarget {
+  [Throws]
+  constructor();
+
+  attribute EventHandler onreading;
+  attribute EventHandler onreadingerror;
+
+  [NewObject]
+  Promise<undefined> scan(optional NDEFScanOptions options = {});
+  [NewObject]
+  Promise<undefined> write(NDEFMessageSource message,
+                           optional NDEFWriteOptions options = {});
+  [NewObject]
+  Promise<undefined> makeReadOnly(optional NDEFMakeReadOnlyOptions options = {});
+};
+
+[SecureContext, Exposed=Window, Func="mozilla::dom::AndroidDevice::Exposed"]
+interface NDEFReadingEvent : Event {
+  [Throws]
+  constructor(DOMString type, NDEFReadingEventInit readingEventInitDict);
+
+  readonly attribute DOMString serialNumber;
+  [SameObject]
+  readonly attribute NDEFMessage message;
+};
+
+dictionary NDEFReadingEventInit : EventInit {
+  DOMString? serialNumber = "";
+  required NDEFMessageInit message;
+};
+
+dictionary NDEFWriteOptions {
+  boolean overwrite = true;
+  AbortSignal? signal;
+};
+
+dictionary NDEFMakeReadOnlyOptions {
+  AbortSignal? signal;
+};
+
+dictionary NDEFScanOptions {
+  AbortSignal signal;
+};
