+++ b/dom/base/ContactsManager.h
@@ -0,0 +1,83 @@
+/* Camoufox: the Contact Picker API (navigator.contacts) for an emulated
+ * Android device.
+ *
+ * Only Chrome on Android has it. There is no address book here: the API has
+ * Chrome's shape and argument checks, and select() ends the way it does when
+ * the user dismisses the picker -- with no contacts. */
+#ifndef mozilla_dom_ContactsManager_h
+#define mozilla_dom_ContactsManager_h
+
+#include "mozilla/dom/AndroidDevice.h"
+#include "mozilla/dom/BindingDeclarations.h"
+#include "nsCOMPtr.h"
+#include "nsCycleCollectionParticipant.h"
+#include "nsIGlobalObject.h"
+#include "nsTArray.h"
+#include "nsWrapperCache.h"
+
+namespace mozilla {
+class ErrorResult;
+
+namespace dom {
+
+class Promise;
+enum class ContactProperty : uint8_t;
+struct ContactsSelectOptions;
+
+class ContactsManager final : public nsISupports, public nsWrapperCache {
+ public:
+  NS_DECL_CYCLE_COLLECTING_ISUPPORTS
+  NS_DECL_CYCLE_COLLECTION_WRAPPERCACHE_CLASS(ContactsManager)
+
+  explicit ContactsManager(nsIGlobalObject* aGlobal) : mGlobal(aGlobal) {}
+
+  nsIGlobalObject* GetParentObject() const { return mGlobal; }
+  JSObject* WrapObject(JSContext* aCx,
+                       JS::Handle<JSObject*> aGivenProto) override;
+
+  already_AddRefed<Promise> GetProperties(ErrorResult& aRv);
+  already_AddRefed<Promise> Select(const Sequence<ContactProperty>& aProperties,
+                                   const ContactsSelectOptions& aOptions,
+                                   ErrorResult& aRv);
+
+ private:
+  ~ContactsManager() = default;
+
+  nsCOMPtr<nsIGlobalObject> mGlobal;
+  bool mPickerInUse = false;
+};
+
+// Never created: select() returns no contacts. It exists so that the
+// interface is there to be found, as in Chrome.
+class ContactAddress final : public nsISupports, public nsWrapperCache {
+ public:
+  NS_DECL_CYCLE_COLLECTING_ISUPPORTS
+  NS_DECL_CYCLE_COLLECTION_WRAPPERCACHE_CLASS(ContactAddress)
+
+  explicit ContactAddress(nsIGlobalObject* aGlobal) : mGlobal(aGlobal) {}
+
+  nsIGlobalObject* GetParentObject() const { return mGlobal; }
+  JSObject* WrapObject(JSContext* aCx,
+                       JS::Handle<JSObject*> aGivenProto) override;
+
+  void GetCity(nsAString& aRetVal) const { aRetVal.Truncate(); }
+  void GetCountry(nsAString& aRetVal) const { aRetVal.Truncate(); }
+  void GetDependentLocality(nsAString& aRetVal) const { aRetVal.Truncate(); }
+  void GetOrganization(nsAString& aRetVal) const { aRetVal.Truncate(); }
+  void GetPhone(nsAString& aRetVal) const { aRetVal.Truncate(); }
+  void GetPostalCode(nsAString& aRetVal) const { aRetVal.Truncate(); }
+  void GetRecipient(nsAString& aRetVal) const { aRetVal.Truncate(); }
+  void GetRegion(nsAString& aRetVal) const { aRetVal.Truncate(); }
+  void GetSortingCode(nsAString& aRetVal) const { aRetVal.Truncate(); }
+  void GetAddressLine(nsTArray<nsString>& aRetVal) const { aRetVal.Clear(); }
+
+ private:
+  ~ContactAddress() = default;
+
+  nsCOMPtr<nsIGlobalObject> mGlobal;
+};
+
+}  // namespace dom
+}  // namespace mozilla
+
+#endif  // mozilla_dom_ContactsManager_h
diff --git a/dom/base/NDEFReader.cpp b/dom/base/NDEFReader.cpp
new file mode 100644
index 0000000000..f4452c7e32
--- /dev/null
+++ b/dom/base/NDEFReader.cpp
@@ -0,0 +1,346 @@
+/* Camoufox: Web NFC for an emulated Android device. See NDEFReader.h. */
+#include "mozilla/dom/NDEFReader.h"
+
+#include "js/ArrayBuffer.h"
+#include "js/experimental/TypedData.h"
+#include "mozilla/dom/AbortSignal.h"
+#include "mozilla/dom/NDEFReaderBinding.h"
+#include "mozilla/dom/Promise.h"
+#include "mozilla/dom/RootedDictionary.h"
+#include "mozilla/dom/TypedArray.h"
+#include "nsAtom.h"
+#include "nsJSUtils.h"
+
+namespace mozilla::dom {
+
+// ---------------------------------------------------------------------------
+// NDEFRecord
+
+NS_IMPL_CYCLE_COLLECTION_WRAPPERCACHE(NDEFRecord, mGlobal, mRecords)
+NS_IMPL_CYCLE_COLLECTING_ADDREF(NDEFRecord)
+NS_IMPL_CYCLE_COLLECTING_RELEASE(NDEFRecord)
+NS_INTERFACE_MAP_BEGIN_CYCLE_COLLECTION(NDEFRecord)
+  NS_WRAPPERCACHE_INTERFACE_MAP_ENTRY
+  NS_INTERFACE_MAP_ENTRY(nsISupports)
+NS_INTERFACE_MAP_END
+
+NDEFRecord::NDEFRecord(nsIGlobalObject* aGlobal) : mGlobal(aGlobal) {
+  mMediaType.SetIsVoid(true);
+  mId.SetIsVoid(true);
+  mEncoding.SetIsVoid(true);
+  mLang.SetIsVoid(true);
+}
+
+JSObject* NDEFRecord::WrapObject(JSContext* aCx,
+                                 JS::Handle<JSObject*> aGivenProto) {
+  return NDEFRecord_Binding::Wrap(aCx, this, aGivenProto);
+}
+
+// Copies the bytes of an ArrayBuffer or ArrayBufferView. False if `aValue` is
+// neither.
+static bool AppendBufferSource(JSContext* aCx, JS::Handle<JS::Value> aValue,
+                               nsTArray<uint8_t>& aOut) {
+  if (!aValue.isObject()) {
+    return false;
+  }
+  JS::Rooted<JSObject*> obj(aCx, &aValue.toObject());
+  if (JS::IsArrayBufferObject(obj)) {
+    RootedSpiderMonkeyInterface<ArrayBuffer> buffer(aCx);
+    return buffer.Init(obj) && buffer.AppendDataTo(aOut);
+  }
+  if (JS_IsArrayBufferViewObject(obj)) {
+    RootedSpiderMonkeyInterface<ArrayBufferView> view(aCx);
+    return view.Init(obj) && view.AppendDataTo(aOut);
+  }
+  return false;
+}
+
+/* static */
+already_AddRefed<NDEFRecord> NDEFRecord::Constructor(
+    const GlobalObject& aGlobal, const NDEFRecordInit& aInit,
+    ErrorResult& aRv) {
+  nsCOMPtr<nsIGlobalObject> global = do_QueryInterface(aGlobal.GetAsSupports());
+  return Create(global, aGlobal.Context(), aInit, aRv);
+}
+
+/* static */
+already_AddRefed<NDEFRecord> NDEFRecord::Create(nsIGlobalObject* aGlobal,
+                                                JSContext* aCx,
+                                                const NDEFRecordInit& aInit,
+                                                ErrorResult& aRv) {
+  RefPtr<NDEFRecord> record = new NDEFRecord(aGlobal);
+  record->mRecordType = aInit.mRecordType;
+  if (record->mRecordType.IsEmpty()) {
+    aRv.ThrowTypeError("The record type is not valid.");
+    return nullptr;
+  }
+  if (aInit.mMediaType.WasPassed()) {
+    record->mMediaType = aInit.mMediaType.Value();
+  }
+  if (aInit.mId.WasPassed()) {
+    record->mId = aInit.mId.Value();
+  }
+
+  JS::Rooted<JS::Value> data(aCx, aInit.mData);
+  const nsString& type = record->mRecordType;
+
+  if (type.EqualsLiteral("empty")) {
+    if (!data.isUndefined()) {
+      aRv.ThrowTypeError("An 'empty' record cannot carry data.");
+      return nullptr;
+    }
+    return record.forget();
+  }
+
+  if (data.isUndefined()) {
+    aRv.ThrowTypeError("The record data is missing.");
+    return nullptr;
+  }
+
+  if (data.isString()) {
+    nsAutoJSString text;
+    if (!text.init(aCx, data)) {
+      aRv.NoteJSContextException(aCx);
+      return nullptr;
+    }
+    const NS_ConvertUTF16toUTF8 utf8(text);
+    record->mData.AppendElements(
+        reinterpret_cast<const uint8_t*>(utf8.get()), utf8.Length());
+    record->mHasData = true;
+  } else if (AppendBufferSource(aCx, data, record->mData)) {
+    record->mHasData = true;
+  } else if (data.isObject() && !type.EqualsLiteral("text") &&
+             !type.EqualsLiteral("url") &&
+             !type.EqualsLiteral("absolute-url") &&
+             !type.EqualsLiteral("mime")) {
+    // A smart-poster, external or local type may carry a whole message.
+    RootedDictionary<NDEFMessageInit> nested(aCx);
+    if (!nested.Init(aCx, data)) {
+      aRv.NoteJSContextException(aCx);
+      return nullptr;
+    }
+    for (const NDEFRecordInit& init : nested.mRecords) {
+      RefPtr<NDEFRecord> child = Create(aGlobal, aCx, init, aRv);
+      if (aRv.Failed()) {
+        return nullptr;
+      }
+      record->mRecords.AppendElement(std::move(child));
+    }
+    record->mHasRecords = true;
+  } else {
+    aRv.ThrowTypeError("The record data is not valid for its type.");
+    return nullptr;
+  }
+
+  if (type.EqualsLiteral("text")) {
+    record->mEncoding = aInit.mEncoding.WasPassed() ? aInit.mEncoding.Value()
+                                                    : u"utf-8"_ns;
+    record->mLang =
+        aInit.mLang.WasPassed() ? aInit.mLang.Value() : nsString(u"en"_ns);
+  } else if (type.EqualsLiteral("mime") && record->mMediaType.IsVoid()) {
+    record->mMediaType.AssignLiteral("application/octet-stream");
+  }
+  return record.forget();
+}
+
+void NDEFRecord::GetData(JSContext* aCx, JS::MutableHandle<JSObject*> aRetVal,
+                         ErrorResult& aRv) const {
+  if (!mHasData) {
+    aRetVal.set(nullptr);
+    return;
+  }
+  JS::Rooted<JSObject*> buffer(aCx, ArrayBuffer::Create(aCx, mData, aRv));
+  if (aRv.Failed()) {
+    return;
+  }
+  JSObject* view = JS_NewDataView(aCx, buffer, 0, mData.Length());
+  if (!view) {
+    aRv.NoteJSContextException(aCx);
+    return;
+  }
+  aRetVal.set(view);
+}
+
+void NDEFRecord::ToRecords(
+    Nullable<nsTArray<RefPtr<NDEFRecord>>>& aRetVal) const {
+  if (!mHasRecords) {
+    aRetVal.SetNull();
+    return;
+  }
+  aRetVal.SetValue(mRecords.Clone());
+}
+
+// ---------------------------------------------------------------------------
+// NDEFMessage
+
+NS_IMPL_CYCLE_COLLECTION_WRAPPERCACHE(NDEFMessage, mGlobal, mRecords)
+NS_IMPL_CYCLE_COLLECTING_ADDREF(NDEFMessage)
+NS_IMPL_CYCLE_COLLECTING_RELEASE(NDEFMessage)
+NS_INTERFACE_MAP_BEGIN_CYCLE_COLLECTION(NDEFMessage)
+  NS_WRAPPERCACHE_INTERFACE_MAP_ENTRY
+  NS_INTERFACE_MAP_ENTRY(nsISupports)
+NS_INTERFACE_MAP_END
+
+JSObject* NDEFMessage::WrapObject(JSContext* aCx,
+                                  JS::Handle<JSObject*> aGivenProto) {
+  return NDEFMessage_Binding::Wrap(aCx, this, aGivenProto);
+}
+
+/* static */
+already_AddRefed<NDEFMessage> NDEFMessage::Constructor(
+    const GlobalObject& aGlobal, const NDEFMessageInit& aInit,
+    ErrorResult& aRv) {
+  nsCOMPtr<nsIGlobalObject> global = do_QueryInterface(aGlobal.GetAsSupports());
+  return Create(global, aGlobal.Context(), aInit, aRv);
+}
+
+/* static */
+already_AddRefed<NDEFMessage> NDEFMessage::Create(nsIGlobalObject* aGlobal,
+                                                  JSContext* aCx,
+                                                  const NDEFMessageInit& aInit,
+                                                  ErrorResult& aRv) {
+  RefPtr<NDEFMessage> message = new NDEFMessage(aGlobal);
+  for (const NDEFRecordInit& init : aInit.mRecords) {
+    RefPtr<NDEFRecord> record = NDEFRecord::Create(aGlobal, aCx, init, aRv);
+    if (aRv.Failed()) {
+      return nullptr;
+    }
+    message->mRecords.AppendElement(std::move(record));
+  }
+  return message.forget();
+}
+
+void NDEFMessage::GetRecords(nsTArray<RefPtr<NDEFRecord>>& aRetVal) const {
+  aRetVal = mRecords.Clone();
+}
+
+// ---------------------------------------------------------------------------
+// NDEFReader
+
+/* static */
+already_AddRefed<NDEFReader> NDEFReader::Constructor(
+    const GlobalObject& aGlobal, ErrorResult& aRv) {
+  nsCOMPtr<nsIGlobalObject> global = do_QueryInterface(aGlobal.GetAsSupports());
+  if (!global) {
+    aRv.Throw(NS_ERROR_FAILURE);
+    return nullptr;
+  }
+  RefPtr<NDEFReader> reader = new NDEFReader(global);
+  return reader.forget();
+}
+
+JSObject* NDEFReader::WrapObject(JSContext* aCx,
+                                 JS::Handle<JSObject*> aGivenProto) {
+  return NDEFReader_Binding::Wrap(aCx, this, aGivenProto);
+}
+
+// The event handler atoms are not part of Gecko's static atom table; dynamic
+// atoms work the same way for EventHandler attributes. Each is atomized once
+// and its reference deliberately kept for the life of the process: a raw
+// pointer has no static destructor to run at shutdown.
+static nsAtom* OnReadingAtom() {
+  static nsAtom* const atom = NS_Atomize(u"onreading"_ns).take();
+  return atom;
+}
+
+static nsAtom* OnReadingErrorAtom() {
+  static nsAtom* const atom = NS_Atomize(u"onreadingerror"_ns).take();
+  return atom;
+}
+
+EventHandlerNonNull* NDEFReader::GetOnreading() {
+  return GetEventHandler(OnReadingAtom());
+}
+
+void NDEFReader::SetOnreading(EventHandlerNonNull* aCallback) {
+  SetEventHandler(OnReadingAtom(), aCallback);
+}
+
+EventHandlerNonNull* NDEFReader::GetOnreadingerror() {
+  return GetEventHandler(OnReadingErrorAtom());
+}
+
+void NDEFReader::SetOnreadingerror(EventHandlerNonNull* aCallback) {
+  SetEventHandler(OnReadingErrorAtom(), aCallback);
+}
+
+already_AddRefed<Promise> NDEFReader::Refuse(AbortSignal* aSignal,
+                                             ErrorResult& aRv) {
+  RefPtr<Promise> promise = Promise::Create(GetRelevantGlobal(), aRv);
+  if (aRv.Failed()) {
+    return nullptr;
+  }
+  // An already-aborted signal wins, as in Chrome.
+  if (aSignal && aSignal->Aborted()) {
+    AutoJSAPI jsapi;
+    if (jsapi.Init(GetRelevantGlobal())) {
+      JS::Rooted<JS::Value> reason(jsapi.cx());
+      aSignal->GetReason(jsapi.cx(), &reason);
+      promise->MaybeReject(reason);
+      return promise.forget();
+    }
+  }
+  promise->MaybeRejectWithNotAllowedError("NFC permission request denied.");
+  return promise.forget();
+}
+
+already_AddRefed<Promise> NDEFReader::Scan(const NDEFScanOptions& aOptions,
+                                           ErrorResult& aRv) {
+  return Refuse(
+      aOptions.mSignal.WasPassed() ? &aOptions.mSignal.Value() : nullptr,
+      aRv);
+}
+
+already_AddRefed<Promise> NDEFReader::Write(
+    JSContext* aCx,
+    const StringOrArrayBufferViewOrArrayBufferOrNDEFMessageInit& aMessage,
+    const NDEFWriteOptions& aOptions, ErrorResult& aRv) {
+  return Refuse(aOptions.mSignal.WasPassed() ? aOptions.mSignal.Value().get()
+                                             : nullptr,
+                aRv);
+}
+
+already_AddRefed<Promise> NDEFReader::MakeReadOnly(
+    const NDEFMakeReadOnlyOptions& aOptions, ErrorResult& aRv) {
+  return Refuse(aOptions.mSignal.WasPassed() ? aOptions.mSignal.Value().get()
+                                             : nullptr,
+                aRv);
+}
+
+// ---------------------------------------------------------------------------
+// NDEFReadingEvent
+
+NS_IMPL_CYCLE_COLLECTION_INHERITED(NDEFReadingEvent, Event, mMessage)
+NS_IMPL_ADDREF_INHERITED(NDEFReadingEvent, Event)
+NS_IMPL_RELEASE_INHERITED(NDEFReadingEvent, Event)
+NS_INTERFACE_MAP_BEGIN_CYCLE_COLLECTION(NDEFReadingEvent)
+NS_INTERFACE_MAP_END_INHERITING(Event)
+
+JSObject* NDEFReadingEvent::WrapObjectInternal(
+    JSContext* aCx, JS::Handle<JSObject*> aGivenProto) {
+  return NDEFReadingEvent_Binding::Wrap(aCx, this, aGivenProto);
+}
+
+/* static */
+already_AddRefed<NDEFReadingEvent> NDEFReadingEvent::Constructor(
+    const GlobalObject& aGlobal, const nsAString& aType,
+    const NDEFReadingEventInit& aInit, ErrorResult& aRv) {
+  nsCOMPtr<EventTarget> owner = do_QueryInterface(aGlobal.GetAsSupports());
+  nsCOMPtr<nsIGlobalObject> global = do_QueryInterface(aGlobal.GetAsSupports());
+  RefPtr<NDEFReadingEvent> event = new NDEFReadingEvent(owner);
+  bool trusted = event->Init(owner);
+  event->InitEvent(aType, aInit.mBubbles, aInit.mCancelable);
+  event->SetTrusted(trusted);
+  event->SetComposed(aInit.mComposed);
+  if (!aInit.mSerialNumber.IsVoid()) {
+    event->mSerialNumber = aInit.mSerialNumber;
+  }
+  event->mMessage =
+      NDEFMessage::Create(global, aGlobal.Context(), aInit.mMessage, aRv);
+  if (aRv.Failed()) {
+    return nullptr;
+  }
+  return event.forget();
+}
+
+}  // namespace mozilla::dom
diff --git a/dom/base/NDEFReader.h b/dom/base/NDEFReader.h
new file mode 100644
index 0000000000..6cb4af9aa2
--- /dev/null
+++ b/dom/base/NDEFReader.h
@@ -0,0 +1,167 @@
+/* Camoufox: Web NFC (NDEFReader, NDEFMessage, NDEFRecord, NDEFReadingEvent)
+ * for an emulated Android device.
+ *
+ * Chrome on Android is the only browser with Web NFC, so its absence is one of
+ * the simplest "this is not a phone" checks. There is no NFC hardware here:
+ * the records and messages are real (constructible, inspectable), and every
+ * operation that would touch a tag is refused with NotAllowedError -- what
+ * Chrome answers when the page does not hold the NFC permission. */
+#ifndef mozilla_dom_NDEFReader_h
+#define mozilla_dom_NDEFReader_h
+
+#include "mozilla/DOMEventTargetHelper.h"
+#include "mozilla/dom/AndroidDevice.h"
+#include "mozilla/dom/BindingDeclarations.h"
+#include "mozilla/dom/Event.h"
+#include "nsCOMPtr.h"
+#include "nsCycleCollectionParticipant.h"
+#include "nsTArray.h"
+#include "nsWrapperCache.h"
+
+namespace mozilla {
+class ErrorResult;
+
+namespace dom {
+
+class AbortSignal;
+class Promise;
+struct NDEFMessageInit;
+struct NDEFRecordInit;
+struct NDEFReadingEventInit;
+struct NDEFScanOptions;
+struct NDEFWriteOptions;
+struct NDEFMakeReadOnlyOptions;
+class OwningStringOrArrayBufferViewOrArrayBufferOrNDEFMessageInit;
+class StringOrArrayBufferViewOrArrayBufferOrNDEFMessageInit;
+
+class NDEFRecord final : public nsISupports, public nsWrapperCache {
+ public:
+  NS_DECL_CYCLE_COLLECTING_ISUPPORTS
+  NS_DECL_CYCLE_COLLECTION_WRAPPERCACHE_CLASS(NDEFRecord)
+
+  static already_AddRefed<NDEFRecord> Constructor(const GlobalObject& aGlobal,
+                                                  const NDEFRecordInit& aInit,
+                                                  ErrorResult& aRv);
+  static already_AddRefed<NDEFRecord> Create(nsIGlobalObject* aGlobal,
+                                             JSContext* aCx,
+                                             const NDEFRecordInit& aInit,
+                                             ErrorResult& aRv);
+
+  nsIGlobalObject* GetParentObject() const { return mGlobal; }
+  JSObject* WrapObject(JSContext* aCx,
