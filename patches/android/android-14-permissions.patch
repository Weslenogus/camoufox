                                         nsIGlobalObject* aGlobal) {
   MOZ_ASSERT(aGlobal);
 
+  // Camoufox: an emulated Android device answers the way Chrome on a fresh
+  // phone does -- anything the user has not explicitly granted is "prompt".
+  // Firefox's own answers leak its configuration instead: a pref-level block
+  // (permissions.default.*) reads "denied", and a persisted "Always Ask"
+  // camera or microphone reads "granted". A real grant, such as Playwright's
+  // context.grantPermissions(), is still reported as granted.
+  if (MaskConfig::IsAndroidDevice()) {
+    return aAction == nsIPermissionManager::ALLOW_ACTION
+               ? PermissionState::Granted
+               : PermissionState::Prompt;
+  }
