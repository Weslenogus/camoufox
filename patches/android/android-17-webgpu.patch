+// Camoufox: the emulated GPU's adapter, from "webGpu:*" (the Android device
+// profiles present the Pixel 10's PowerVR adapter as Chrome reports it). Keys
+// that are not set keep the host adapter's value.
+static void GetConfiguredInfo(const char* aKey, nsString& aOut) {
+  if (auto value = MaskConfig::GetString(aKey)) {
+    CopyUTF8toUTF16(*value, aOut);
+  } else {
+    aOut.Truncate();
+  }
+}
+
+void AdapterInfo::GetVendor(nsString& s) const {
+  GetConfiguredInfo("webGpu:vendor", s);
+}
+void AdapterInfo::GetArchitecture(nsString& s) const {
+  GetConfiguredInfo("webGpu:architecture", s);
+}
+void AdapterInfo::GetDevice(nsString& s) const {
+  GetConfiguredInfo("webGpu:device", s);
+}
+void AdapterInfo::GetDescription(nsString& s) const {
+  GetConfiguredInfo("webGpu:description", s);
+}
