   if (GetParentObject()->ShouldResistFingerprinting(RFPTarget::WebGPULimits)) {
     ffi::wgpu_client_fill_default_limits(mLimits->mFfi.get());
   }
+
+  // Camoufox: the emulated GPU's features ("webGpu:features", replacing the
+  // host adapter's; names Gecko does not know are skipped) and limits.
+  if (auto names = MaskConfig::GetStringList("webGpu:features");
+      !names.empty()) {
+    RefPtr<SupportedFeatures> features = new SupportedFeatures(this);
+    for (const auto& name : names) {
+      if (auto feature = dom::StringToEnum<dom::GPUFeatureName>(
+              nsDependentCString(name.c_str()))) {
+        features->Add(*feature, ignoredRv);
+      }
+    }
+    mFeatures = features;
+  }
+  ApplyConfiguredLimits(mLimits->mFfi.get());
 }
 
