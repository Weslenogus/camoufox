+// Camoufox: the emulated GPU's limits ("webGpu:limits", an object of limit
+// name to value). Unlisted limits keep the host adapter's.
+static void ApplyConfiguredLimits(ffi::WGPULimits* aLimits) {
+  static const std::pair<const char*, Limit> kNames[] = {
+      {"maxTextureDimension1D", Limit::MaxTextureDimension1D},
+      {"maxTextureDimension2D", Limit::MaxTextureDimension2D},
+      {"maxTextureDimension3D", Limit::MaxTextureDimension3D},
+      {"maxTextureArrayLayers", Limit::MaxTextureArrayLayers},
+      {"maxBindGroups", Limit::MaxBindGroups},
+      {"maxBindGroupsPlusVertexBuffers", Limit::MaxBindGroupsPlusVertexBuffers},
+      {"maxBindingsPerBindGroup", Limit::MaxBindingsPerBindGroup},
+      {"maxDynamicUniformBuffersPerPipelineLayout",
+       Limit::MaxDynamicUniformBuffersPerPipelineLayout},
+      {"maxDynamicStorageBuffersPerPipelineLayout",
+       Limit::MaxDynamicStorageBuffersPerPipelineLayout},
+      {"maxSampledTexturesPerShaderStage",
+       Limit::MaxSampledTexturesPerShaderStage},
+      {"maxSamplersPerShaderStage", Limit::MaxSamplersPerShaderStage},
+      {"maxStorageBuffersInVertexStage", Limit::MaxStorageBuffersInVertexStage},
+      {"maxStorageBuffersInFragmentStage",
+       Limit::MaxStorageBuffersInFragmentStage},
+      {"maxStorageBuffersPerShaderStage",
+       Limit::MaxStorageBuffersPerShaderStage},
+      {"maxStorageTexturesInVertexStage",
+       Limit::MaxStorageTexturesInVertexStage},
+      {"maxStorageTexturesInFragmentStage",
+       Limit::MaxStorageTexturesInFragmentStage},
+      {"maxStorageTexturesPerShaderStage",
+       Limit::MaxStorageTexturesPerShaderStage},
+      {"maxUniformBuffersPerShaderStage",
+       Limit::MaxUniformBuffersPerShaderStage},
+      {"maxUniformBufferBindingSize", Limit::MaxUniformBufferBindingSize},
+      {"maxStorageBufferBindingSize", Limit::MaxStorageBufferBindingSize},
+      {"minUniformBufferOffsetAlignment",
+       Limit::MinUniformBufferOffsetAlignment},
+      {"minStorageBufferOffsetAlignment",
+       Limit::MinStorageBufferOffsetAlignment},
+      {"maxVertexBuffers", Limit::MaxVertexBuffers},
+      {"maxBufferSize", Limit::MaxBufferSize},
+      {"maxVertexAttributes", Limit::MaxVertexAttributes},
+      {"maxVertexBufferArrayStride", Limit::MaxVertexBufferArrayStride},
+      {"maxInterStageShaderVariables", Limit::MaxInterStageShaderVariables},
+      {"maxColorAttachments", Limit::MaxColorAttachments},
+      {"maxColorAttachmentBytesPerSample",
+       Limit::MaxColorAttachmentBytesPerSample},
+      {"maxComputeWorkgroupStorageSize", Limit::MaxComputeWorkgroupStorageSize},
+      {"maxComputeInvocationsPerWorkgroup",
+       Limit::MaxComputeInvocationsPerWorkgroup},
+      {"maxComputeWorkgroupSizeX", Limit::MaxComputeWorkgroupSizeX},
+      {"maxComputeWorkgroupSizeY", Limit::MaxComputeWorkgroupSizeY},
+      {"maxComputeWorkgroupSizeZ", Limit::MaxComputeWorkgroupSizeZ},
+      {"maxComputeWorkgroupsPerDimension",
+       Limit::MaxComputeWorkgroupsPerDimension},
+  };
+  const auto& config = MaskConfig::GetJson();
+  if (!config.is_object()) {
+    return;
+  }
+  auto limits = config.find("webGpu:limits");
+  if (limits == config.end() || !limits->is_object()) {
+    return;
+  }
+  for (const auto& [name, limit] : kNames) {
+    auto value = limits->find(name);
+    if (value != limits->end() && value->is_number_unsigned()) {
+      SetLimit(aLimits, limit, value->get<uint64_t>());
+    }
+  }
+}
