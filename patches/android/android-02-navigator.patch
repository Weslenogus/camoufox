+/* Camoufox: Android device emulation -- WebIDL exposure gates and shared
+ * values. */
+#include "mozilla/dom/AndroidDevice.h"
+
+#include "MaskConfig.hpp"
+
+namespace mozilla::dom {
+
+/* static */
+bool AndroidDevice::IsEmulated() { return MaskConfig::IsAndroidDevice(); }
+
+/* static */
+std::optional<double> AndroidDevice::DeviceMemory() {
+  static const std::optional<double> value =
+      MaskConfig::GetDouble("navigator.deviceMemory");
+  return value;
+}
+
+/* static */
+bool AndroidDevice::HasDeviceMemory(JSContext*, JSObject*) {
+  // Firefox has no navigator.deviceMemory. It appears only when a value is
+  // configured, so desktop Firefox fingerprints keep their shape.
+  return DeviceMemory().has_value();
+}
+
+}  // namespace mozilla::dom
diff --git a/dom/base/AndroidDevice.h b/dom/base/AndroidDevice.h
new file mode 100644
index 0000000000..f9629db4b1
--- /dev/null
+++ b/dom/base/AndroidDevice.h
@@ -0,0 +1,31 @@
+/* Camoufox: Android device emulation -- WebIDL exposure gates and shared
+ * values. Everything here reads CAMOU_CONFIG through MaskConfig, which a
+ * generated binding cannot include, so the definitions live in the .cpp. */
+#ifndef mozilla_dom_AndroidDevice_h
+#define mozilla_dom_AndroidDevice_h
+
+#include <optional>
+
+class JSObject;
+struct JSContext;
+
+namespace mozilla::dom {
+
+class AndroidDevice {
+ public:
+  // True when the config describes an Android device ("device:android",
+  // set by the Android device profiles). Safe on any thread.
+  static bool IsEmulated();
+
+  // navigator.deviceMemory, when configured. Chrome only ever reports one of
+  // 0.25, 0.5, 1, 2, 4 or 8 -- the value is passed through as configured.
+  static std::optional<double> DeviceMemory();
+
+  // WebIDL Func= gates. They take (JSContext*, JSObject*) so that they work
+  // for Window- and Worker-exposed members alike.
+  static bool HasDeviceMemory(JSContext*, JSObject*);
+};
+
+}  // namespace mozilla::dom
+
+#endif  // mozilla_dom_AndroidDevice_h
