+++ b/dom/webidl/NavigatorUAData.webidl
@@ -0,0 +1,56 @@
+/* -*- Mode: IDL; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/.
+ *
+ * The origin of this IDL file is
+ * https://wicg.github.io/ua-client-hints/#interface
+ *
+ * Camoufox: Firefox has no User-Agent Client Hints. This interface exists
+ * only when "userAgentData:brands" is configured (NavigatorUAData::IsEnabled),
+ * so a desktop Firefox fingerprint keeps its shape.
+ */
+
+dictionary NavigatorUABrandVersion {
+  DOMString brand;
+  DOMString version;
+};
+
+dictionary UADataValues {
+  DOMString architecture;
+  DOMString bitness;
+  sequence<NavigatorUABrandVersion> brands;
+  sequence<DOMString> formFactors;
+  sequence<NavigatorUABrandVersion> fullVersionList;
+  DOMString model;
+  boolean mobile;
+  DOMString platform;
+  DOMString platformVersion;
+  DOMString uaFullVersion; // deprecated in favor of fullVersionList
+  boolean wow64;
+};
+
+dictionary UALowEntropyJSON {
+  sequence<NavigatorUABrandVersion> brands;
+  boolean mobile;
+  DOMString platform;
+};
+
+[Exposed=(Window,Worker), SecureContext,
+ Func="mozilla::dom::NavigatorUAData::IsEnabled"]
+interface NavigatorUAData {
+  [Frozen, Cached, Pure]
+  readonly attribute sequence<NavigatorUABrandVersion> brands;
+  readonly attribute boolean mobile;
+  readonly attribute DOMString platform;
+  [NewObject]
+  Promise<UADataValues> getHighEntropyValues(sequence<DOMString> hints);
+  UALowEntropyJSON toJSON();
+};
+
+interface mixin NavigatorUA {
+  [SecureContext, SameObject, Func="mozilla::dom::NavigatorUAData::IsEnabled"]
+  readonly attribute NavigatorUAData userAgentData;
+};
