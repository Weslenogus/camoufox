diff --git a/dom/base/NavigatorUAData.cpp b/dom/base/NavigatorUAData.cpp
new file mode 100644
index 0000000000..965447fb32
--- /dev/null
+++ b/dom/base/NavigatorUAData.cpp
@@ -0,0 +1,119 @@
+/* Camoufox: navigator.userAgentData (User-Agent Client Hints). */
+#include "mozilla/dom/NavigatorUAData.h"
+
+#include "UAClientHints.hpp"
+#include "mozilla/dom/NavigatorUADataBinding.h"
+#include "mozilla/dom/Promise.h"
+
+namespace mozilla::dom {
+
+namespace ClientHints = MaskConfig::ClientHints;
+
+NS_IMPL_CYCLE_COLLECTION_WRAPPERCACHE(NavigatorUAData, mGlobal)
+NS_IMPL_CYCLE_COLLECTING_ADDREF(NavigatorUAData)
+NS_IMPL_CYCLE_COLLECTING_RELEASE(NavigatorUAData)
+NS_INTERFACE_MAP_BEGIN_CYCLE_COLLECTION(NavigatorUAData)
+  NS_WRAPPERCACHE_INTERFACE_MAP_ENTRY
+  NS_INTERFACE_MAP_ENTRY(nsISupports)
+NS_INTERFACE_MAP_END
+
+NavigatorUAData::NavigatorUAData(nsIGlobalObject* aGlobal)
+    : mGlobal(aGlobal) {}
+
+/* static */
+bool NavigatorUAData::IsEnabled(JSContext*, JSObject*) {
+  return ClientHints::Enabled();
+}
+
+JSObject* NavigatorUAData::WrapObject(JSContext* aCx,
+                                      JS::Handle<JSObject*> aGivenProto) {
+  return NavigatorUAData_Binding::Wrap(aCx, this, aGivenProto);
+}
+
+// Works for both the attribute's nsTArray and a dictionary's Sequence.
+template <typename Array>
+static void FillBrandList(const char* aKey, Array& aOut) {
+  for (const auto& [brand, version] : ClientHints::GetBrandList(aKey)) {
+    NavigatorUABrandVersion* entry = aOut.AppendElement(fallible);
+    if (!entry) {
+      return;
+    }
+    entry->mBrand.Construct(NS_ConvertUTF8toUTF16(brand));
+    entry->mVersion.Construct(NS_ConvertUTF8toUTF16(version));
+  }
+}
+
+static nsString ConfigString(const char* aKey) {
+  return NS_ConvertUTF8toUTF16(MaskConfig::GetString(aKey).value_or(""));
+}
+
+void NavigatorUAData::GetBrands(
+    nsTArray<NavigatorUABrandVersion>& aRetVal) const {
+  FillBrandList("userAgentData:brands", aRetVal);
+}
+
+bool NavigatorUAData::Mobile() const {
+  return MaskConfig::CheckBool("userAgentData:mobile");
+}
+
+void NavigatorUAData::GetPlatform(nsAString& aRetVal) const {
+  aRetVal = ConfigString("userAgentData:platform");
+}
+
+already_AddRefed<Promise> NavigatorUAData::GetHighEntropyValues(
+    const Sequence<nsString>& aHints, ErrorResult& aRv) {
+  RefPtr<Promise> promise = Promise::Create(mGlobal, aRv);
+  if (aRv.Failed()) {
+    return nullptr;
+  }
+
+  // The low-entropy values are always part of the result; each requested
+  // high-entropy hint is added on top, and unknown hints are ignored.
+  UADataValues values;
+  FillBrandList("userAgentData:brands", values.mBrands.Construct());
+  values.mMobile.Construct(Mobile());
+  values.mPlatform.Construct(ConfigString("userAgentData:platform"));
+
+  for (const nsString& hint : aHints) {
+    if (hint.EqualsLiteral("architecture")) {
+      values.mArchitecture.Construct(
+          ConfigString("userAgentData:architecture"));
+    } else if (hint.EqualsLiteral("bitness")) {
+      values.mBitness.Construct(ConfigString("userAgentData:bitness"));
+    } else if (hint.EqualsLiteral("formFactors")) {
+      auto& formFactors = values.mFormFactors.Construct();
+      for (const auto& factor :
+           MaskConfig::GetStringList("userAgentData:formFactors")) {
+        if (!formFactors.AppendElement(NS_ConvertUTF8toUTF16(factor),
+                                       fallible)) {
+          aRv.Throw(NS_ERROR_OUT_OF_MEMORY);
+          return nullptr;
+        }
+      }
+    } else if (hint.EqualsLiteral("fullVersionList")) {
+      FillBrandList("userAgentData:fullVersionList",
+                    values.mFullVersionList.Construct());
+    } else if (hint.EqualsLiteral("model")) {
+      values.mModel.Construct(ConfigString("userAgentData:model"));
+    } else if (hint.EqualsLiteral("platformVersion")) {
+      values.mPlatformVersion.Construct(
+          ConfigString("userAgentData:platformVersion"));
+    } else if (hint.EqualsLiteral("uaFullVersion")) {
+      values.mUaFullVersion.Construct(
+          ConfigString("userAgentData:uaFullVersion"));
+    } else if (hint.EqualsLiteral("wow64")) {
+      values.mWow64.Construct(MaskConfig::CheckBool("userAgentData:wow64"));
+    }
+  }
+
+  promise->MaybeResolve(values);
+  return promise.forget();
+}
+
+void NavigatorUAData::ToJSON(UALowEntropyJSON& aRetVal) const {
+  FillBrandList("userAgentData:brands", aRetVal.mBrands.Construct());
+  aRetVal.mMobile.Construct(Mobile());
+  aRetVal.mPlatform.Construct(ConfigString("userAgentData:platform"));
+}
+
+}  // namespace mozilla::dom
diff --git a/dom/base/NavigatorUAData.h b/dom/base/NavigatorUAData.h
new file mode 100644
index 0000000000..ad8eb8ae0d
--- /dev/null
+++ b/dom/base/NavigatorUAData.h
@@ -0,0 +1,54 @@
+/* Camoufox: navigator.userAgentData (User-Agent Client Hints).
+ *
+ * Every value comes from CAMOU_CONFIG through MaskConfig::ClientHints, the
+ * same source the Sec-CH-UA request headers are built from, so the page's
+ * view and the wire cannot disagree. */
+#ifndef mozilla_dom_NavigatorUAData_h
+#define mozilla_dom_NavigatorUAData_h
+
+#include "mozilla/dom/BindingDeclarations.h"
+#include "nsCOMPtr.h"
+#include "nsCycleCollectionParticipant.h"
+#include "nsIGlobalObject.h"
+#include "nsWrapperCache.h"
+
+namespace mozilla {
+class ErrorResult;
+
+namespace dom {
+
+class Promise;
+struct NavigatorUABrandVersion;
+struct UALowEntropyJSON;
+
+class NavigatorUAData final : public nsISupports, public nsWrapperCache {
+ public:
+  NS_DECL_CYCLE_COLLECTING_ISUPPORTS
+  NS_DECL_CYCLE_COLLECTION_WRAPPERCACHE_CLASS(NavigatorUAData)
+
+  explicit NavigatorUAData(nsIGlobalObject* aGlobal);
+
+  // WebIDL Func= gate: client hints exist only when configured.
+  static bool IsEnabled(JSContext*, JSObject*);
+
+  nsIGlobalObject* GetParentObject() const { return mGlobal; }
+  JSObject* WrapObject(JSContext* aCx,
+                       JS::Handle<JSObject*> aGivenProto) override;
+
+  void GetBrands(nsTArray<NavigatorUABrandVersion>& aRetVal) const;
+  bool Mobile() const;
+  void GetPlatform(nsAString& aRetVal) const;
+  already_AddRefed<Promise> GetHighEntropyValues(
+      const Sequence<nsString>& aHints, ErrorResult& aRv);
+  void ToJSON(UALowEntropyJSON& aRetVal) const;
+
+ private:
+  ~NavigatorUAData() = default;
+
+  nsCOMPtr<nsIGlobalObject> mGlobal;
+};
+
+}  // namespace dom
+}  // namespace mozilla
+
+#endif  // mozilla_dom_NavigatorUAData_h
