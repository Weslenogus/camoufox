+#include "nsContentUtils.h"
 
 namespace mozilla::dom {
 
@@ -26,4 +28,14 @@ bool AndroidDevice::HasDeviceMemory(JSContext*, JSObject*) {
 /* static */
 bool AndroidDevice::Exposed(JSContext*, JSObject*) { return IsEmulated(); }
 
+/* static */
+bool AndroidDevice::HasBatteryAPI(JSContext*, JSObject* aGlobal) {
+  // What ChromeOnly checked: a system-principal global.
+  if (nsIPrincipal* principal = nsContentUtils::ObjectPrincipal(aGlobal);
+      principal && principal->IsSystemPrincipal()) {
+    return true;
+  }
+  return IsEmulated();
+}
+
 }  // namespace mozilla::dom
