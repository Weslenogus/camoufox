diff --git a/dom/base/AndroidDevice.cpp b/dom/base/AndroidDevice.cpp
index 99aac18e54..43944fea2b 100644
--- a/dom/base/AndroidDevice.cpp
+++ b/dom/base/AndroidDevice.cpp
@@ -28,14 +28,20 @@ bool AndroidDevice::HasDeviceMemory(JSContext*, JSObject*) {
 /* static */
 bool AndroidDevice::Exposed(JSContext*, JSObject*) { return IsEmulated(); }
 
+static bool IsSystemGlobal(JSObject* aGlobal) {
+  nsIPrincipal* principal = nsContentUtils::ObjectPrincipal(aGlobal);
+  return principal && principal->IsSystemPrincipal();
+}
+
 /* static */
 bool AndroidDevice::HasBatteryAPI(JSContext*, JSObject* aGlobal) {
   // What ChromeOnly checked: a system-principal global.
-  if (nsIPrincipal* principal = nsContentUtils::ObjectPrincipal(aGlobal);
-      principal && principal->IsSystemPrincipal()) {
-    return true;
-  }
-  return IsEmulated();
+  return IsSystemGlobal(aGlobal) || IsEmulated();
+}
+
+/* static */
+bool AndroidDevice::IsNotEmulated(JSContext*, JSObject* aGlobal) {
+  return !IsEmulated() || IsSystemGlobal(aGlobal);
 }
 
 }  // namespace mozilla::dom
diff --git a/dom/base/AndroidDevice.h b/dom/base/AndroidDevice.h
index 8fa3ad316b..4bae9a5622 100644
--- a/dom/base/AndroidDevice.h
+++ b/dom/base/AndroidDevice.h
@@ -27,6 +27,9 @@ class AndroidDevice {
   // For an API only Chrome on Android has (Web NFC, the Contact Picker,
   // window.orientation). Secure-context requirements stay in the IDL.
   static bool Exposed(JSContext*, JSObject*);
+  // For a member only Firefox has, which Chrome lacks. Always true for
+  // system-principal globals, which may rely on it.
+  static bool IsNotEmulated(JSContext*, JSObject* aGlobal);
   // Firefox keeps the Battery Status API for its own UI; Chrome on Android
   // exposes it to secure pages.
   static bool HasBatteryAPI(JSContext*, JSObject* aGlobal);
