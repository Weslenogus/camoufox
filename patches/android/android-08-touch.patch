+// ---------------------------------------------------------------------------
+// Camoufox: fingertips for synthesized input on an emulated Android device.
+//
+// Automation synthesizes touches as 1px points with no rotation, and pointer
+// events from synthesized mouse input have no contact geometry at all. A phone
+// only ever sees fingertips: an elliptical contact 36-62 CSS px across, tilted
+// a little, pressed with real force. Each new contact draws its own finger
+// from the configured ranges --
+//
+//   "touch:radiusRange"     radiusX, CSS px             default [18, 31]
+//   "touch:radiusYDelta"    radiusY = radiusX +/- this  default 3
+//   "touch:rotationRange"   rotationAngle, degrees      default [0, 27]
+//   "touch:forceRange"      force                       default [0.38, 0.80]
+//
+// -- and keeps it for the rest of the gesture, wobbling slightly as a
+// pressed finger does.
+// ---------------------------------------------------------------------------
+
+namespace {
+
+struct FingerRanges {
+  double mRadiusLo = 18, mRadiusHi = 31;
+  double mRadiusYDelta = 3;
+  double mRotationLo = 0, mRotationHi = 27;
+  double mForceLo = 0.38, mForceHi = 0.80;
+};
+
+void ReadRange(const char* aKey, double& aLo, double& aHi) {
+  const auto& config = MaskConfig::GetJson();
+  if (!config.is_object()) {
+    return;
+  }
+  auto range = config.find(aKey);
+  if (range != config.end() && range->is_array() && range->size() == 2 &&
+      (*range)[0].is_number() && (*range)[1].is_number()) {
+    aLo = (*range)[0].get<double>();
+    aHi = (*range)[1].get<double>();
+  }
+}
+
+const FingerRanges& Ranges() {
+  static const FingerRanges ranges = [] {
+    FingerRanges r;
+    ReadRange("touch:radiusRange", r.mRadiusLo, r.mRadiusHi);
+    ReadRange("touch:rotationRange", r.mRotationLo, r.mRotationHi);
+    ReadRange("touch:forceRange", r.mForceLo, r.mForceHi);
+    r.mRadiusYDelta =
+        MaskConfig::GetDouble("touch:radiusYDelta").value_or(r.mRadiusYDelta);
+    return r;
+  }();
+  return ranges;
+}
+
+non_crypto::XorShift128PlusRNG& FingerRng() {
+  static non_crypto::XorShift128PlusRNG rng(RandomUint64OrDie(),
+                                            RandomUint64OrDie());
+  return rng;
+}
+
+double Uniform(double aLo, double aHi) {
+  return aLo + (aHi - aLo) * FingerRng().nextDouble();
+}
+
+}  // namespace
+
+/* static */
+bool Touch::EmulatesFingers() { return MaskConfig::IsAndroidDevice(); }
+
+/* static */
+Touch::EmulatedFinger Touch::FingerFor(int32_t aIdentifier, bool aNewContact) {
+  MOZ_ASSERT(NS_IsMainThread());
+  static nsTHashMap<int32_t, EmulatedFinger> sFingers;
+  const FingerRanges& r = Ranges();
+
+  if (!aNewContact) {
+    if (auto finger = sFingers.Lookup(aIdentifier)) {
+      // The same finger, pressing a touch harder or softer.
+      EmulatedFinger& f = finger.Data();
+      const auto wobble = [](double aValue, double aBy, double aLo,
+                             double aHi) {
+        return std::clamp(aValue + Uniform(-aBy, aBy), aLo, aHi);
+      };
+      f.mRadiusX = int32_t(std::lround(
+          wobble(f.mRadiusX, 1.0, r.mRadiusLo, r.mRadiusHi)));
+      f.mRadiusY = int32_t(std::lround(wobble(
+          f.mRadiusY, 1.0, f.mRadiusX - r.mRadiusYDelta,
+          f.mRadiusX + r.mRadiusYDelta)));
+      f.mForce = float(wobble(f.mForce, 0.02, r.mForceLo, r.mForceHi));
+      return f;
+    }
+  }
+
+  EmulatedFinger finger;
+  finger.mRadiusX = int32_t(std::lround(Uniform(r.mRadiusLo, r.mRadiusHi)));
+  finger.mRadiusY = int32_t(std::lround(
+      finger.mRadiusX + Uniform(-r.mRadiusYDelta, r.mRadiusYDelta)));
+  finger.mRotationAngle = float(Uniform(r.mRotationLo, r.mRotationHi));
+  finger.mForce = float(Uniform(r.mForceLo, r.mForceHi));
+  sFingers.InsertOrUpdate(aIdentifier, finger);
+  return finger;
+}
+
 }  // namespace mozilla::dom
