@@ -1730,6 +1732,17 @@ bool Gecko_AssertClassAttrValueIsSane(const nsAttrValue* aValue) {
 void Gecko_GetSafeAreaInsets(const nsPresContext* aPresContext, float* aTop,
                              float* aRight, float* aBottom, float* aLeft) {
   MOZ_ASSERT(aPresContext);
+  // Camoufox: the emulated display's insets, in CSS pixels, for
+  // env(safe-area-inset-*). A desktop window has none; a phone has the status
+  // and gesture bars.
+  if (auto top = MaskConfig::GetDouble("screen.safeAreaInsetTop")) {
+    *aTop = float(*top);
+    *aRight = float(MaskConfig::GetDouble("screen.safeAreaInsetRight").value_or(0));
+    *aBottom =
+        float(MaskConfig::GetDouble("screen.safeAreaInsetBottom").value_or(0));
+    *aLeft = float(MaskConfig::GetDouble("screen.safeAreaInsetLeft").value_or(0));
+    return;
+  }
