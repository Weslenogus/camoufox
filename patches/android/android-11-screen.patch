+// Camoufox: a fixed orientation for an emulated screen that is not the host's
+// ("screen.orientation.type" and "screen.orientation.angle"). The host's own
+// screen -- almost always a landscape desktop display -- never shows through.
+static Maybe<OrientationType> ConfiguredOrientationType() {
+  static const Maybe<OrientationType> type = []() -> Maybe<OrientationType> {
+    auto value = MaskConfig::GetString("screen.orientation.type");
+    if (!value) {
+      return Nothing();
+    }
+    if (*value == "portrait-primary") {
+      return Some(OrientationType::Portrait_primary);
+    }
+    if (*value == "portrait-secondary") {
+      return Some(OrientationType::Portrait_secondary);
+    }
+    if (*value == "landscape-primary") {
+      return Some(OrientationType::Landscape_primary);
+    }
+    if (*value == "landscape-secondary") {
+      return Some(OrientationType::Landscape_secondary);
+    }
+    return Nothing();
+  }();
+  return type;
+}
+
+static Maybe<uint16_t> ConfiguredOrientationAngle() {
+  static const Maybe<uint16_t> angle = []() -> Maybe<uint16_t> {
+    if (auto value = MaskConfig::GetUint32("screen.orientation.angle")) {
+      return Some(static_cast<uint16_t>(*value % 360));
+    }
+    return Nothing();
+  }();
+  return angle;
+}
+
 OrientationType ScreenOrientation::DeviceType(CallerType aCallerType) const {
+  if (auto type = ConfiguredOrientationType()) {
+    return *type;
+  }
   if (nsContentUtils::ShouldResistFingerprinting(
           aCallerType, GetRelevantGlobal(), RFPTarget::ScreenOrientation)) {
     Document* doc = GetResponsibleDocument();
@@ -721,6 +762,9 @@ OrientationType ScreenOrientation::DeviceType(CallerType aCallerType) const {
