+  // Camoufox: an emulated phone reports its configured devicePixelRatio here
+  // too, so `(resolution: 2.625dppx)` agrees with window.devicePixelRatio.
+  // Firefox cannot render at 2.625 exactly (app units are integers), so this
+  // has to come from the config rather than from the pres context.
+  if (MaskConfig::IsAndroidDevice()) {
+    if (auto dpr = MaskConfig::GetDouble("window.devicePixelRatio")) {
+      return float(*dpr);
+    }
+  }
+
