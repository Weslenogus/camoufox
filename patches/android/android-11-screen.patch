           aCallerType, GetRelevantGlobal(), RFPTarget::ScreenOrientation)) {
     Document* doc = GetResponsibleDocument();
@@ -706,6 +747,9 @@ OrientationType ScreenOrientation::DeviceType(CallerType aCallerType) const {
