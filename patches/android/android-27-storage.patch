diff --git a/dom/quota/StorageManager.cpp b/dom/quota/StorageManager.cpp
index 918c493646..14cc940013 100644
--- a/dom/quota/StorageManager.cpp
+++ b/dom/quota/StorageManager.cpp
@@ -4,6 +4,10 @@
 
 #include "StorageManager.h"
 
+#include <algorithm>
+
+#include "MaskConfig.hpp"
+
 #include <cstdint>
 #include <cstdlib>
 
@@ -477,6 +481,23 @@ nsresult RequestResolver::GetStorageEstimate(nsIVariant* aResult) {
   MOZ_ALWAYS_SUCCEEDS(
       estimateResult->GetLimit(&mStorageEstimate.mQuota.Construct()));
 
+  // Camoufox: the emulated device's storage. The quota is the device's
+  // ("storage:quota"); usage is a baseline ("storage:usageBase") plus what the
+  // origin really stores, so writing data still moves it. Chrome also reports
+  // a per-type breakdown; Gecko keeps none, so it all counts as IndexedDB.
+  if (auto quota = MaskConfig::GetUint64("storage:quota")) {
+    const uint64_t usage =
+        MaskConfig::GetUint64("storage:usageBase").value_or(0) +
+        mStorageEstimate.mUsage.Value();
+    mStorageEstimate.mUsage.Value() = usage;
+    mStorageEstimate.mQuota.Value() = std::max(*quota, usage);
+    auto& details = mStorageEstimate.mUsageDetails.Construct();
+    if (auto* entry = details.Entries().AppendElement(fallible)) {
+      entry->mKey.AssignLiteral(u"indexedDB");
+      entry->mValue = usage;
+    }
+  }
+
   return NS_OK;
 }
 
